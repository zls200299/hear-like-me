<view class="page-background page-background--{{tone}}" aria-hidden="true">
  <view class="page-background__base"></view>
  <image
    wx:if="{{resolvedSrc}}"
    class="page-background__image"
    src="{{resolvedSrc}}"
    mode="aspectFill"
    binderror="onImageError"
  />
  <view class="page-background__overlay"></view>
</view>
