<view class="sv-root">
  <view class="sv-tab-row">
    <view
      wx:for="{{vizTabs}}"
      wx:key="id"
      class="sv-tab {{activeView === item.id ? 'sv-tab--active' : ''}}"
      data-view="{{item.id}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <view class="sv-meta">{{vizMeta}}</view>

  <view class="sv-stage">
    <view wx:if="{{activeView === 'bars'}}" class="sv-pane">
      <view class="sv-bars">
        <view wx:for="{{electrodeBarLevels}}" wx:key="channelIndex" class="sv-bar-row">
          <view class="sv-bar-track">
            <view
              class="sv-bar-fill sv-bar-fill-{{item.colorIndex}} {{item.glow ? 'sv-bar-fill--glow' : ''}}"
              style="width: {{item.percent}}%; opacity: {{item.opacity}};"
            ></view>
          </view>
        </view>
      </view>
    </view>

    <canvas
      wx:elif="{{activeView === 'cochlea'}}"
      type="2d"
      id="cochleaCanvas"
      class="sv-canvas"
    ></canvas>

    <canvas
      wx:elif="{{activeView === 'wave' || activeView === 'neuro'}}"
      type="2d"
      id="vizCanvas"
      class="sv-canvas"
    ></canvas>

    <canvas
      wx:elif="{{activeView === 'spec'}}"
      type="2d"
      id="specCanvas"
      class="sv-canvas"
    ></canvas>
  </view>

  <view class="sv-footer-scale">
    <text>{{axisLeft}}</text>
    <text class="sv-footer-scale__center">{{axisCenter}}</text>
    <text>{{axisRight}}</text>
  </view>

  <view class="sv-badges">
    <view class="sv-badge">
      <view class="sv-badge__dot {{realtimeActive || isAudioPlaying ? 'sv-badge__dot--live' : ''}}"></view>
      <text>实时联动展示</text>
    </view>
    <view class="sv-badge">
      <text>{{badgeModeText}}</text>
    </view>
  </view>
</view>
