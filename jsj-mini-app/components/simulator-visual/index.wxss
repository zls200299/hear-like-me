.sv-root {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sv-tab-scroll {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
}

.sv-tab-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 4rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.sv-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.55);
  flex-shrink: 0;
  white-space: nowrap;
}

.sv-tab--active {
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.14);
}

.sv-meta {
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.42);
  text-align: right;
}

.sv-stage {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #0c1220;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sv-pane {
  width: 100%;
  height: 100%;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}

.sv-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
}

.sv-axis {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.38);
}

.sv-axis text:nth-child(2) {
  flex: 1;
  text-align: center;
}

.sv-bars {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 0;
  width: 100%;
  height: 100%;
}

.sv-bar-row {
  flex: 1 1 0;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 6rpx;
  max-height: 28rpx;
}

.sv-bar-track {
  width: 100%;
  height: 100%;
  min-height: 6rpx;
  max-height: 22rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.sv-bar-fill {
  height: 100%;
  min-width: 2%;
  border-radius: 10rpx;
  transition: width 55ms linear, opacity 55ms linear;
}

.sv-bar-fill--glow {
  box-shadow: 0 0 14rpx rgba(22, 185, 166, 0.45);
}

.sv-bar-fill-0 { background: linear-gradient(90deg, #2B2E83, #3A3F9E); }
.sv-bar-fill-1 { background: linear-gradient(90deg, #1E5FA8, #1E7CC2); }
.sv-bar-fill-2 { background: linear-gradient(90deg, #128F86, #16B9A6); }
.sv-bar-fill-3 { background: linear-gradient(90deg, #35D0BA, #5ED9C5); }
.sv-bar-fill-4 { background: linear-gradient(90deg, #5CB832, #7DC93F); }
.sv-bar-fill-5 { background: linear-gradient(90deg, #9BB82E, #C4D43A); }
.sv-bar-fill-6 { background: linear-gradient(90deg, #D9A82E, #F2C14E); }
.sv-bar-fill-7 { background: linear-gradient(90deg, #E89B4A, #F2A65A); }
