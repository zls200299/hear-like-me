.sv-root {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.sv-tab-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 8rpx;
  width: 100%;
  margin: 32rpx 0 28rpx;
}

.sv-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 8rpx 6rpx;
  border-radius: 20rpx;
  border: 1rpx solid #4b5b72;
  background: rgba(16, 28, 44, 0.75);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #aab7ca;
  text-align: center;
  white-space: nowrap;
}

.sv-tab--active {
  color: #eefaff;
  border-color: #72819a;
  background: linear-gradient(180deg, rgba(79, 90, 110, 0.56), rgba(64, 74, 92, 0.72));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.sv-meta {
  font-size: 28rpx;
  line-height: 1.4;
  color: #8ea0bb;
}

.sv-stage {
  position: relative;
  width: 100%;
  height: 580rpx;
  margin-top: 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(70, 88, 114, 0.68);
  background: linear-gradient(180deg, #07142a, #0a1425);
}

.sv-pane {
  width: 100%;
  height: 100%;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.sv-canvas {
  display: block;
  width: 100%;
  height: 580rpx;
}

.sv-footer-scale {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #8d9eb7;
}

.sv-footer-scale__center {
  flex: 1;
  text-align: center;
}

.sv-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sv-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #8ea0bb;
  background: rgba(20, 31, 48, 0.68);
  border: 1rpx solid rgba(72, 88, 110, 0.65);
}

.sv-badge__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2fe0c3;
  opacity: 0.45;
}

.sv-badge__dot--live {
  opacity: 1;
  box-shadow: 0 0 10rpx rgba(47, 224, 195, 0.45);
}

.sv-bars {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 0;
  width: 100%;
  height: 100%;
}

.sv-bar-row {
  flex: 1 1 0;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 6rpx;
  max-height: 28rpx;
}

.sv-bar-track {
  width: 100%;
  height: 100%;
  min-height: 6rpx;
  max-height: 22rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.sv-bar-fill {
  height: 100%;
  min-width: 2%;
  border-radius: 10rpx;
  transition: width 55ms linear, opacity 55ms linear;
}

.sv-bar-fill--glow {
  box-shadow: 0 0 14rpx rgba(22, 185, 166, 0.45);
}

.sv-bar-fill-0 { background: linear-gradient(90deg, #2B2E83, #3A3F9E); }
.sv-bar-fill-1 { background: linear-gradient(90deg, #1E5FA8, #1E7CC2); }
.sv-bar-fill-2 { background: linear-gradient(90deg, #128F86, #16B9A6); }
.sv-bar-fill-3 { background: linear-gradient(90deg, #35D0BA, #5ED9C5); }
.sv-bar-fill-4 { background: linear-gradient(90deg, #5CB832, #7DC93F); }
.sv-bar-fill-5 { background: linear-gradient(90deg, #9BB82E, #C4D43A); }
.sv-bar-fill-6 { background: linear-gradient(90deg, #D9A82E, #F2C14E); }
.sv-bar-fill-7 { background: linear-gradient(90deg, #E89B4A, #F2A65A); }
