.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-start;
  padding: 8rpx 24rpx calc(6rpx + env(safe-area-inset-bottom));
  background: rgba(4, 12, 26, 0.96);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-sizing: border-box;
}

.tab-bar-border {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: rgba(116, 144, 181, 0.18);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #6f809c;
  transition: color 0.18s ease, transform 0.18s ease;
}

.tab-bar-item:active {
  transform: scale(0.96);
}

.tab-bar-item.active {
  color: #29dbc7;
}

.icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  transition: background 0.18s ease, box-shadow 0.18s ease;
}

.tab-bar-item.active .icon-wrap {
  background: rgba(41, 219, 199, 0.18);
  box-shadow: 0 0 32rpx rgba(41, 219, 199, 0.12);
}

.tab-bar-label {
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
}
