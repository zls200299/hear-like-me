<view class="learn-page page-with-bg safe-bottom">
  <image class="page-bg" src="/assets/study-bg.png" mode="widthFix" aria-hidden="true" />

  <view class="page-content learn-content">
    <view class="learn-hero">
      <view class="learn-hero__copy">
        <view class="learn-hero__title">听觉知识库</view>
        <view class="learn-hero__heading">了解听觉，也理解人工耳蜗</view>
        <view class="learn-hero__desc">把复杂原理讲清楚，把听觉体验讲明白。</view>
      </view>
      <view class="learn-warning">
        <view class="learn-warning__icon">
          <hlm-icon name="learn-warning" size="40" color="#ffbb3e" />
        </view>
        <text class="learn-warning__text">本模块用于听觉与人工耳蜗相关知识科普，不替代专业医疗建议。</text>
      </view>
    </view>

    <view class="learn-section-title">学习专题</view>

    <view class="learn-topic-grid">
      <view
        wx:for="{{topics}}"
        wx:key="id"
        class="learn-topic"
        data-id="{{item.id}}"
        bindtap="onTopicTap"
      >
        <view class="learn-topic__icon">
          <hlm-icon name="{{item.icon}}" size="64" color="#28e0d0" />
        </view>
        <view class="learn-topic__body">
          <view class="learn-topic__title">{{item.title}}</view>
          <view class="learn-topic__desc">{{item.desc}}</view>
        </view>
        <view class="learn-topic__enter">
          <text>进入</text>
          <hlm-icon name="learn-enter" size="30" color="#28e0d0" />
        </view>
      </view>
    </view>

    <view class="learn-harvest">
      <view class="learn-harvest__title">学习收获</view>
      <view class="learn-harvest__pills">
        <view
          wx:for="{{pills}}"
          wx:key="label"
          class="learn-pill"
        >
          <hlm-icon name="{{item.icon}}" size="32" color="#28e0d0" />
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
