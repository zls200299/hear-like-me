.detail-page {
  min-height: 100vh;
  overflow: hidden;
  background: #020914;
  color: #f4f8fd;
}

.detail-page.page-with-bg {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.detail-content {
  position: relative;
  z-index: 2;
  padding: 34rpx 42rpx 56rpx;
}

.detail-hero {
  position: relative;
  min-height: 344rpx;
  padding: 26rpx 0 44rpx;
}

.detail-kicker {
  color: #49d9cf;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.detail-hero__title {
  position: relative;
  z-index: 2;
  width: 490rpx;
  margin-top: 24rpx;
  color: #f7fbff;
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 800;
}

.detail-hero__desc {
  position: relative;
  z-index: 2;
  width: 454rpx;
  margin-top: 22rpx;
  color: #aebdce;
  font-size: 27rpx;
  line-height: 1.68;
}

.detail-hero__visual {
  position: absolute;
  right: -116rpx;
  bottom: 20rpx;
  width: 370rpx;
  height: 244rpx;
  opacity: 0.58;
}

.lead-block {
  position: relative;
  margin-top: 8rpx;
  padding: 4rpx 0 4rpx 28rpx;
}

.lead-block::before {
  content: '';
  position: absolute;
  left: 0;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: #2bd8cd;
  box-shadow: 0 0 20rpx rgba(43, 216, 205, 0.22);
}

.lead-block__label {
  color: #48dcd2;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.lead-block__title {
  margin-top: 10rpx;
  color: #f4f8fc;
  font-size: 33rpx;
  line-height: 1.46;
  font-weight: 800;
}

.lead-block__text {
  margin-top: 14rpx;
  color: #aebccd;
  font-size: 26rpx;
  line-height: 1.72;
}

.reading-section {
  margin-top: 66rpx;
  padding-top: 48rpx;
  border-top: 1rpx solid rgba(110, 140, 172, 0.18);
}

.reading-title {
  color: #f5f8fc;
  font-size: 38rpx;
  line-height: 1.32;
  font-weight: 800;
}

.reading-intro {
  margin-top: 12rpx;
  color: #90a2b8;
  font-size: 25rpx;
  line-height: 1.62;
}

.process-list {
  margin-top: 34rpx;
}

.process-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 132rpx;
}

.process-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 23rpx;
  top: 52rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: rgba(43, 216, 205, 0.28);
}

.process-marker {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(43, 216, 205, 0.58);
  border-radius: 50%;
  background: #071522;
  color: #43ded3;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
}

.process-copy {
  flex: 1;
  min-width: 0;
  padding: 1rpx 0 30rpx 24rpx;
}

.process-title {
  color: #edf4fa;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.process-text {
  margin-top: 8rpx;
  color: #a4b3c5;
  font-size: 25rpx;
  line-height: 1.64;
}

.sound-route {
  position: relative;
  margin-top: 38rpx;
  display: flex;
  justify-content: space-between;
}

.sound-route__line {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 14rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(43, 216, 205, 0.72), rgba(43, 216, 205, 0.18));
}

.sound-route__step {
  position: relative;
  z-index: 1;
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #91a3b9;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.sound-route__dot {
  width: 28rpx;
  height: 28rpx;
  border: 6rpx solid #071522;
  border-radius: 50%;
  background: #658096;
}

.sound-route__step--active {
  color: #50e1d6;
}

.sound-route__step--active .sound-route__dot {
  background: #2bd8cd;
  box-shadow: 0 0 18rpx rgba(43, 216, 205, 0.45);
}

.reading-note {
  margin-top: 34rpx;
  padding-left: 22rpx;
  border-left: 3rpx solid rgba(43, 216, 205, 0.5);
  color: #aab8c9;
  font-size: 25rpx;
  line-height: 1.68;
}

.compare-list {
  margin-top: 30rpx;
}

.compare-item {
  display: grid;
  grid-template-columns: 140rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 24rpx 0;
}

.compare-item + .compare-item {
  border-top: 1rpx solid rgba(110, 140, 172, 0.16);
}

.compare-name {
  color: #dfe8f1;
  font-size: 27rpx;
  line-height: 1.55;
  font-weight: 700;
}

.compare-text {
  color: #9fafc1;
  font-size: 25rpx;
  line-height: 1.65;
}

.frequency-block {
  margin-top: 34rpx;
  padding-top: 34rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(110, 140, 172, 0.16);
}

.frequency-copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.frequency-title {
  color: #eaf2f8;
  font-size: 29rpx;
  line-height: 1.45;
  font-weight: 700;
}

.frequency-text {
  margin-top: 10rpx;
  color: #9fafc1;
  font-size: 24rpx;
  line-height: 1.65;
}

.frequency-image {
  width: 190rpx;
  height: 164rpx;
  flex-shrink: 0;
  opacity: 0.82;
}

.page-footnote {
  margin-top: 64rpx;
  padding-top: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-top: 1rpx solid rgba(110, 140, 172, 0.18);
  color: #708299;
  font-size: 22rpx;
  line-height: 1.6;
}

.page-footnote__mark {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(91, 159, 166, 0.65);
  border-radius: 50%;
  color: #63bbb8;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
}
