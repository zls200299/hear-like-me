.detail-page {
  min-height: 100vh;
  overflow: hidden;
  background: #020914;
  color: #f4f8fd;
}

.detail-page.page-with-bg {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.detail-content {
  position: relative;
  z-index: 2;
  padding: 30rpx 34rpx 58rpx;
}

.detail-hero {
  position: relative;
  min-height: 360rpx;
  padding: 28rpx 0 36rpx;
}

.detail-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(43, 226, 211, 0.52);
  border-radius: 21rpx;
  background: rgba(8, 49, 58, 0.55);
  color: #59eee2;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
}

.detail-hero__title {
  position: relative;
  z-index: 2;
  width: 470rpx;
  margin-top: 28rpx;
  color: #f7fbff;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
}

.detail-hero__desc {
  position: relative;
  z-index: 2;
  width: 438rpx;
  margin-top: 20rpx;
  color: #b7c4d4;
  font-size: 26rpx;
  line-height: 1.68;
}

.detail-hero__visual {
  position: absolute;
  right: -92rpx;
  bottom: 18rpx;
  width: 386rpx;
  height: 252rpx;
  opacity: 0.82;
}

.key-card,
.path-card,
.compare-card,
.map-card,
.tip-card,
.plain-list {
  border: 1rpx solid rgba(88, 126, 164, 0.46);
  border-radius: 20rpx;
  background: rgba(6, 22, 38, 0.88);
}

.key-card {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  border-color: rgba(43, 226, 211, 0.5);
  background: rgba(7, 42, 50, 0.82);
}

.key-card__icon {
  width: 86rpx;
  height: 86rpx;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(43, 226, 211, 0.08);
  border: 1rpx solid rgba(43, 226, 211, 0.38);
}

.key-card__body {
  flex: 1;
  min-width: 0;
}

.section-eyebrow {
  color: #52e9de;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 700;
}

.key-card__title {
  margin-top: 8rpx;
  color: #f7fbff;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
}

.key-card__text {
  margin-top: 12rpx;
  color: #b9c6d5;
  font-size: 25rpx;
  line-height: 1.68;
}

.section-head {
  display: flex;
  align-items: flex-start;
  margin: 52rpx 4rpx 22rpx;
}

.section-number {
  min-width: 56rpx;
  padding-top: 4rpx;
  color: #2be2d3;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
}

.section-title {
  color: #f7fbff;
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: 800;
}

.section-desc {
  margin-top: 8rpx;
  color: #94a5ba;
  font-size: 24rpx;
  line-height: 1.55;
}

.plain-list {
  padding: 8rpx 24rpx;
}

.plain-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.plain-item + .plain-item {
  border-top: 1rpx solid rgba(116, 146, 178, 0.18);
}

.plain-item__icon {
  width: 76rpx;
  height: 76rpx;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(17, 56, 79, 0.74);
}

.plain-item__body {
  flex: 1;
  min-width: 0;
}

.plain-item__title {
  color: #edf5fb;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 700;
}

.plain-item__text {
  margin-top: 8rpx;
  color: #aebbcc;
  font-size: 24rpx;
  line-height: 1.58;
}

.path-card {
  padding: 28rpx 24rpx 24rpx;
}

.path-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.path-row + .path-row {
  margin-top: 18rpx;
}

.path-node {
  min-width: 112rpx;
  height: 54rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  border: 1rpx solid rgba(103, 185, 255, 0.36);
  background: rgba(15, 48, 75, 0.72);
  color: #d8e6f3;
  font-size: 24rpx;
  font-weight: 700;
}

.path-node--active {
  border-color: rgba(43, 226, 211, 0.58);
  color: #63f0e5;
  background: rgba(9, 67, 70, 0.72);
}

.path-arrow {
  margin: 0 12rpx;
  color: #4fded4;
  font-size: 28rpx;
  line-height: 1;
}

.path-note {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(43, 226, 211, 0.08);
  color: #b6c5d5;
  font-size: 24rpx;
  line-height: 1.62;
}

.compare-card {
  padding: 4rpx 24rpx;
}

.compare-row {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
}

.compare-row + .compare-row {
  border-top: 1rpx solid rgba(116, 146, 178, 0.18);
}

.compare-icon {
  width: 78rpx;
  height: 78rpx;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(17, 56, 79, 0.74);
}

.compare-icon--ci {
  background: rgba(9, 65, 66, 0.68);
}

.compare-body {
  flex: 1;
  min-width: 0;
}

.compare-title {
  color: #eef6fc;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
}

.compare-text {
  margin-top: 8rpx;
  color: #aebccd;
  font-size: 24rpx;
  line-height: 1.6;
}

.map-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  background: rgba(7, 25, 43, 0.9);
}

.map-card__copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.map-card__title {
  margin-top: 8rpx;
  color: #f1f7fd;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
}

.map-card__text {
  margin-top: 10rpx;
  color: #aebccd;
  font-size: 24rpx;
  line-height: 1.6;
}

.map-card__image {
  width: 204rpx;
  height: 188rpx;
  flex-shrink: 0;
  opacity: 0.9;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  margin-top: 42rpx;
  padding: 24rpx;
  border-color: rgba(255, 189, 61, 0.38);
  background: rgba(46, 37, 18, 0.5);
}

.tip-card__icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: rgba(255, 189, 61, 0.08);
}

.tip-card__body {
  flex: 1;
  min-width: 0;
}

.tip-card__title {
  color: #f3f5f8;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.tip-card__text {
  margin-top: 8rpx;
  color: #b8b5ae;
  font-size: 22rpx;
  line-height: 1.55;
}
