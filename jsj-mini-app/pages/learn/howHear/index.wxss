/* 声音如何被听见详情页 */
.hear-page {
  min-height: 100vh;
  overflow: hidden;
  background: #020914;
  color: #f5f7fb;
}

.hear-page.page-with-bg {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.hear-content {
  position: relative;
  z-index: 2;
  padding: 34rpx 34rpx 58rpx;
}

.hear-hero {
  position: relative;
  min-height: 330rpx;
  padding: 20rpx 0 26rpx;
  display: flex;
  align-items: center;
}

.hear-hero__copy {
  position: relative;
  z-index: 2;
  width: 59%;
  min-width: 0;
}

.hear-hero__title {
  color: #34e2d5;
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: 0;
}

.hear-hero__subtitle {
  margin-top: 22rpx;
  color: #f4f8fd;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hear-hero__desc {
  margin-top: 18rpx;
  color: #b6c3d4;
  font-size: 26rpx;
  line-height: 1.64;
}

.hear-hero__art {
  position: absolute;
  right: -38rpx;
  bottom: 30rpx;
  width: 286rpx;
  height: 230rpx;
  opacity: 0.82;
}

.essay-section {
  margin-top: 14rpx;
}

.section-title {
  margin-top: 0;
  color: #f3f8fd;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
  letter-spacing: 0;
}

.section-title--mark {
  display: inline;
  padding: 0 8rpx;
  background: rgba(24, 124, 116, 0.58);
}

.section-copy {
  margin-top: 18rpx;
  color: #aebccd;
  font-size: 27rpx;
  line-height: 1.72;
}

.principle-grid {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.principle-card {
  min-height: 234rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(70, 103, 139, 0.48);
  border-radius: 20rpx;
  background: rgba(17, 31, 55, 0.78);
}

.step-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #22cfc6;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.step-dot {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #22d9cf, #2ea7df);
  box-shadow: 0 0 22rpx rgba(34, 217, 207, 0.22);
}

.step-title {
  margin-top: 34rpx;
  color: #f4f8fd;
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 800;
}

.step-desc {
  margin-top: 16rpx;
  color: #aebccd;
  font-size: 25rpx;
  line-height: 1.65;
}

.journey-map,
.note-card {
  margin-top: 30rpx;
  border: 1rpx solid rgba(69, 98, 132, 0.42);
  border-radius: 20rpx;
  background: rgba(14, 29, 52, 0.66);
}

.journey-section {
  margin-top: 60rpx;
}

.journey-map {
  padding: 26rpx 24rpx 28rpx;
}

.map-label {
  color: #73849d;
  font-size: 22rpx;
  line-height: 1;
  letter-spacing: 3rpx;
}

.journey-stage {
  margin-top: 16rpx;
}

.journey-band {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 8rpx;
}

.journey-band__left,
.journey-band__right {
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.journey-band__left {
  color: rgba(125, 201, 63, 0.88);
}

.journey-band__right {
  color: rgba(22, 185, 166, 0.9);
}

.journey-stage__body {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.journey-canvas {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 12rpx;
}

.journey-nodes {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.journey-node {
  position: absolute;
  top: 46%;
  /* top 对应画布中的信号轴；只回退圆半径，确保圆心与连线严格重合 */
  transform: translate(-50%, -34rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.journey-node__circle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 节点位于画布上层，用实色遮住延伸到节点中心的通道线 */
  background: #151f36;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 0 0 6rpx rgba(22, 185, 166, 0.12);
}

.journey-node__circle--sound {
  box-shadow: 0 0 0 6rpx rgba(125, 201, 63, 0.14);
}

.journey-node__circle--proc {
  box-shadow: 0 0 0 6rpx rgba(22, 185, 166, 0.16);
}

.journey-node__circle--elec {
  box-shadow: 0 0 0 6rpx rgba(242, 193, 78, 0.14);
}

.journey-node__circle--brain {
  box-shadow: 0 0 0 6rpx rgba(30, 124, 194, 0.16);
}

.journey-node__label {
  margin-top: 10rpx;
  color: #aab7d6;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.journey-flow {
  margin-top: 12rpx;
  padding: 18rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(78, 112, 151, 0.26);
  border-radius: 16rpx;
  background: rgba(7, 19, 36, 0.58);
}

.journey-flow__step {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #b8c5d7;
  font-size: 21rpx;
  line-height: 1.25;
  font-weight: 600;
  white-space: nowrap;
}

.journey-flow__dot {
  width: 9rpx;
  height: 9rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 12rpx currentColor;
}

.journey-flow__step--sound {
  color: #8bcd55;
}

.journey-flow__step--proc {
  color: #2bd6c8;
}

.journey-flow__step--elec {
  color: #e3bd54;
}

.journey-flow__step--brain {
  color: #79aee0;
}

.journey-flow__arrow {
  flex: 0 0 auto;
  margin: 0 4rpx;
  color: rgba(116, 143, 175, 0.66);
  font-size: 30rpx;
  line-height: 1;
  font-weight: 300;
}

.note-card {
  padding: 24rpx 26rpx;
  border-color: rgba(43, 226, 211, 0.28);
}

.note-title {
  color: #4ee7dc;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
}

.note-text {
  margin-top: 10rpx;
  color: #aebccd;
  font-size: 25rpx;
  line-height: 1.65;
}
