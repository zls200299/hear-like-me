/* 声音如何被听见详情页 */
.hear-page {
  min-height: 100vh;
  overflow: hidden;
  background: #020914;
  color: #f5f7fb;
}

.hear-page.page-with-bg {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.hear-content {
  position: relative;
  z-index: 2;
  padding: 34rpx 34rpx 58rpx;
}

.hear-hero {
  position: relative;
  min-height: 330rpx;
  padding: 20rpx 0 26rpx;
  display: flex;
  align-items: center;
}

.hear-hero__copy {
  position: relative;
  z-index: 2;
  width: 59%;
  min-width: 0;
}

.hear-hero__title {
  color: #34e2d5;
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: 0;
}

.hear-hero__subtitle {
  margin-top: 22rpx;
  color: #f4f8fd;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hear-hero__desc {
  margin-top: 18rpx;
  color: #b6c3d4;
  font-size: 26rpx;
  line-height: 1.64;
}

.hear-hero__art {
  position: absolute;
  right: -38rpx;
  bottom: 30rpx;
  width: 286rpx;
  height: 230rpx;
  opacity: 0.82;
}

.essay-section {
  margin-top: 14rpx;
}

.section-kicker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #22cfc6;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
}

.section-line {
  width: 56rpx;
  height: 2rpx;
  background: rgba(34, 207, 198, 0.72);
}

.section-title {
  margin-top: 28rpx;
  color: #f3f8fd;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
  letter-spacing: 0;
}

.section-title--mark {
  display: inline;
  padding: 0 8rpx;
  background: rgba(24, 124, 116, 0.58);
}

.section-copy {
  margin-top: 18rpx;
  color: #aebccd;
  font-size: 27rpx;
  line-height: 1.72;
}

.principle-grid {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.principle-card {
  min-height: 234rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(70, 103, 139, 0.48);
  border-radius: 20rpx;
  background: rgba(17, 31, 55, 0.78);
}

.step-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #22cfc6;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.step-dot {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #22d9cf, #2ea7df);
  box-shadow: 0 0 22rpx rgba(34, 217, 207, 0.22);
}

.step-title {
  margin-top: 34rpx;
  color: #f4f8fd;
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 800;
}

.step-desc {
  margin-top: 16rpx;
  color: #aebccd;
  font-size: 25rpx;
  line-height: 1.65;
}

.signal-card,
.journey-map,
.note-card {
  margin-top: 30rpx;
  border: 1rpx solid rgba(69, 98, 132, 0.42);
  border-radius: 20rpx;
  background: rgba(14, 29, 52, 0.66);
}

.signal-card {
  padding: 24rpx 24rpx 24rpx;
}

.signal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #73849d;
  font-size: 22rpx;
  line-height: 1;
}

.signal-title {
  letter-spacing: 2rpx;
}

.signal-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #1ccbc1;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1ccbc1;
  box-shadow: 0 0 14rpx rgba(28, 203, 193, 0.55);
}

.signal-visual {
  margin-top: 16rpx;
}

.signal-diagram {
  width: 100%;
  height: 186rpx;
  display: block;
}

.signal-caption {
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(91, 125, 160, 0.18);
  color: #7789a2;
  font-size: 23rpx;
  line-height: 1.58;
  text-align: center;
}

.journey-section {
  margin-top: 60rpx;
}

.journey-map {
  padding: 26rpx 24rpx 28rpx;
}

.map-label {
  color: #73849d;
  font-size: 22rpx;
  line-height: 1;
  letter-spacing: 3rpx;
}

.journey-visual {
  margin-top: 14rpx;
}

.journey-diagram {
  width: 100%;
  height: 322rpx;
  display: block;
}

.note-card {
  padding: 24rpx 26rpx;
  border-color: rgba(43, 226, 211, 0.28);
}

.note-title {
  color: #4ee7dc;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
}

.note-text {
  margin-top: 10rpx;
  color: #aebccd;
  font-size: 25rpx;
  line-height: 1.65;
}
