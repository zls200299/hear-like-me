.child-page {
  min-height: 100vh;
  overflow: hidden;
  background: #020914;
  color: #f4f8fd;
}

.child-page.page-with-bg {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.child-content {
  position: relative;
  z-index: 2;
  padding: 34rpx 42rpx 58rpx;
}

.child-hero {
  position: relative;
  min-height: 336rpx;
  padding: 24rpx 0 38rpx;
  display: flex;
  align-items: center;
}

.child-hero__copy {
  position: relative;
  z-index: 2;
  width: 490rpx;
}

.child-hero__label {
  color: #45d9cf;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.child-hero__title {
  margin-top: 22rpx;
  color: #f7fbff;
  font-size: 50rpx;
  line-height: 1.18;
  font-weight: 800;
}

.child-hero__desc {
  width: 454rpx;
  margin-top: 20rpx;
  color: #aebdce;
  font-size: 26rpx;
  line-height: 1.7;
}

.child-hero__visual {
  position: absolute;
  right: -30rpx;
  top: 76rpx;
  width: 202rpx;
  height: 202rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.child-hero__ring {
  position: absolute;
  inset: 0;
  border: 1rpx solid rgba(66, 217, 207, 0.22);
  border-radius: 50%;
  box-shadow: 0 0 60rpx rgba(66, 217, 207, 0.08) inset;
}

.child-hero__ring::after {
  content: '';
  position: absolute;
  inset: 28rpx;
  border: 1rpx solid rgba(66, 217, 207, 0.14);
  border-radius: 50%;
}

.child-hero__visual image {
  position: relative;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
}

.early-message {
  position: relative;
  margin-top: 8rpx;
  padding: 4rpx 0 4rpx 28rpx;
}

.early-message::before {
  content: '';
  position: absolute;
  left: 0;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: #42d9cf;
}

.early-message__label {
  color: #49ded4;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.early-message__number {
  margin-top: 8rpx;
  color: #f5f9fd;
  font-size: 54rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.early-message__steps {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  color: #c3cfdb;
  font-size: 24rpx;
  line-height: 1.45;
}

.early-message__steps text {
  position: relative;
}

.early-message__steps text + text::before {
  content: '·';
  position: absolute;
  left: -16rpx;
  color: #4b687d;
}

.early-message__note {
  margin-top: 18rpx;
  color: #94a6ba;
  font-size: 24rpx;
  line-height: 1.68;
}

.reading-section {
  margin-top: 68rpx;
  padding-top: 48rpx;
  border-top: 1rpx solid rgba(110, 140, 172, 0.18);
}

.section-title {
  color: #f5f9fd;
  font-size: 38rpx;
  line-height: 1.32;
  font-weight: 800;
}

.section-intro {
  margin-top: 12rpx;
  color: #91a3b8;
  font-size: 25rpx;
  line-height: 1.65;
}

.timeline-list {
  margin-top: 36rpx;
}

.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 174rpx;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 31rpx;
  top: 70rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: rgba(66, 217, 207, 0.26);
}

.timeline-marker {
  position: relative;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(66, 217, 207, 0.42);
  border-radius: 50%;
  background: #071624;
}

.timeline-marker image {
  width: 34rpx;
  height: 34rpx;
}

.timeline-copy {
  flex: 1;
  min-width: 0;
  padding: 0 0 34rpx 24rpx;
}

.timeline-time {
  color: #43d9cf;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 700;
}

.timeline-title {
  margin-top: 7rpx;
  color: #edf4fa;
  font-size: 29rpx;
  line-height: 1.4;
  font-weight: 750;
}

.timeline-text {
  margin-top: 8rpx;
  color: #a3b2c4;
  font-size: 24rpx;
  line-height: 1.64;
}

.path-list {
  margin-top: 28rpx;
}

.path-item {
  display: flex;
  align-items: flex-start;
  padding: 27rpx 0;
}

.path-item + .path-item {
  border-top: 1rpx solid rgba(110, 140, 172, 0.16);
}

.path-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(66, 217, 207, 0.07);
}

.path-icon image {
  width: 38rpx;
  height: 38rpx;
}

.path-copy {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.path-title {
  color: #eaf2f8;
  font-size: 28rpx;
  line-height: 1.42;
  font-weight: 750;
}

.path-text {
  margin-top: 8rpx;
  color: #9fafc1;
  font-size: 24rpx;
  line-height: 1.64;
}

.choice-note {
  margin-top: 14rpx;
  padding-left: 22rpx;
  border-left: 3rpx solid rgba(66, 217, 207, 0.46);
  color: #aab8c8;
  font-size: 24rpx;
  line-height: 1.65;
}

.support-grid {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border: 1rpx solid rgba(89, 121, 155, 0.24);
  border-radius: 20rpx;
  background: rgba(7, 23, 40, 0.58);
}

.support-item {
  min-height: 216rpx;
  padding: 25rpx 23rpx;
}

.support-item:nth-child(2n) {
  border-left: 1rpx solid rgba(89, 121, 155, 0.2);
}

.support-item:nth-child(n + 3) {
  border-top: 1rpx solid rgba(89, 121, 155, 0.2);
}

.support-item image {
  width: 36rpx;
  height: 36rpx;
}

.support-title {
  margin-top: 15rpx;
  color: #e7eff6;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.support-text {
  margin-top: 8rpx;
  color: #91a4b8;
  font-size: 22rpx;
  line-height: 1.56;
}

.parent-message {
  margin-top: 66rpx;
  padding: 32rpx 0;
  display: flex;
  align-items: flex-start;
  border-top: 1rpx solid rgba(66, 217, 207, 0.25);
  border-bottom: 1rpx solid rgba(66, 217, 207, 0.16);
}

.parent-message__icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(66, 217, 207, 0.08);
}

.parent-message__icon image {
  width: 38rpx;
  height: 38rpx;
}

.parent-message__copy {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.parent-message__label {
  color: #48ddd3;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.parent-message__text {
  margin-top: 9rpx;
  color: #dbe6ee;
  font-size: 27rpx;
  line-height: 1.65;
  font-weight: 650;
}

.page-footnote {
  margin-top: 28rpx;
  color: #708298;
  font-size: 21rpx;
  line-height: 1.62;
}
