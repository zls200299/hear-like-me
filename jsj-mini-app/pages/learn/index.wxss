/* 按确认稿的 414px 画布换算为 750rpx，保留原生导航和自定义 tabBar。 */
.learn-page.page-with-bg {
  min-height: 100vh;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  color: #f1f5fc;
  background-color: #020814;
  line-height: 1.55;
}

.learn-page .learn-content {
  position: relative;
  z-index: 2;
  padding: 42rpx 33rpx 47rpx;
}

.learn-hero {
  margin: 0 4rpx 31rpx;
}

.learn-hero__title {
  margin-bottom: 13rpx;
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 750;
  letter-spacing: 2rpx;
  color: #23dccb;
}

.learn-hero__heading {
  color: #d8e2ee;
  font-size: 27rpx;
  font-weight: 500;
}

.learn-svg {
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.learn-warning {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 33rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #1b666b;
  border-radius: 22rpx;
  background: #071721;
}

.learn-warning__icon {
  width: 36rpx;
  height: 36rpx;
}

.learn-warning__text {
  min-width: 0;
  color: #a8b9c9;
  font-size: 20rpx;
  line-height: 1.7;
}

.learn-entry {
  position: relative;
  overflow: hidden;
  margin-bottom: 45rpx;
  padding: 34rpx 34rpx 31rpx;
  border: 2rpx solid #258b8c;
  border-radius: 33rpx;
  background: linear-gradient(115deg, #0a343c, #0a242f 70%, #0b3040);
}

.learn-entry::after {
  content: '';
  position: absolute;
  top: -54rpx;
  right: -49rpx;
  width: 232rpx;
  height: 232rpx;
  border: 2rpx solid rgba(43, 230, 211, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.learn-entry--pressed {
  border-color: #23dccb;
  opacity: 0.9;
}

.learn-entry__tag {
  margin-bottom: 11rpx;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #72c5c4;
}

.learn-entry__title {
  margin-bottom: 14rpx;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.learn-entry__desc {
  max-width: 460rpx;
  color: #b0c8d1;
  font-size: 22rpx;
  line-height: 1.7;
}

.learn-entry__cta {
  display: flex;
  align-items: center;
  gap: 13rpx;
  margin-top: 25rpx;
  color: #23dccb;
  font-size: 24rpx;
  font-weight: 600;
}

.learn-entry__arrow {
  width: 29rpx;
  height: 29rpx;
}

.learn-entry__illustration {
  position: absolute;
  right: 24rpx;
  top: 43rpx;
  width: 181rpx;
  height: 190rpx;
  pointer-events: none;
}

.learn-section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 4rpx 24rpx;
}

.learn-section-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.learn-section-caption {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #75899e;
}

.learn-topic-grid {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.learn-topic {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 181rpx;
  padding: 31rpx 24rpx;
  border: 2rpx solid #283f57;
  border-radius: 27rpx;
  background: #091726;
}

.learn-topic--pressed {
  background: #0b2030;
  border-color: #287b80;
}

.learn-topic__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  border: 2rpx solid #117c83;
  border-radius: 50%;
  background: #062732;
}

.learn-topic__symbol {
  width: 47rpx;
  height: 47rpx;
}

.learn-topic__body {
  flex: 1;
  min-width: 0;
}

.learn-topic__title {
  margin-bottom: 9rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.learn-topic__desc {
  color: #9cacbf;
  font-size: 22rpx;
  line-height: 1.7;
}

.learn-topic__arrow {
  width: 27rpx;
  height: 33rpx;
}
