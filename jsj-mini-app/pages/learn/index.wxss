.learn-page {
  min-height: 100vh;
  background-color: #020814;
}

.learn-page.page-with-bg {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.learn-content {
  position: relative;
  z-index: 2;
  padding: 24rpx 40rpx 0;
}

.learn-hero {
  position: relative;
  min-height: 0;
  overflow: visible;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.learn-hero__copy {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 560rpx;
  padding: 12rpx 8rpx 16rpx;
}

.learn-hero__title {
  font-size: 56rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 1rpx;
  background: linear-gradient(180deg, #28ead8 0%, #1fc1cf 52%, #1a8fc6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.learn-hero__heading {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: #f5f7fb;
}

.learn-hero__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #b4bed0;
}

.learn-warning {
  position: relative;
  z-index: 3;
  min-height: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0 0;
  padding: 16rpx 22rpx;
  border: 2rpx solid rgba(27, 197, 174, 0.72);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(8, 39, 45, 0.45), rgba(8, 27, 40, 0.45));
}

.learn-warning__icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.learn-warning__text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.45;
  color: #d5dbe6;
}

.learn-section-title {
  margin: 36rpx 0 24rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #f5f7fb;
}

.learn-topic-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.learn-topic {
  position: relative;
  min-height: 0;
  border: 2rpx solid rgba(79, 108, 145, 0.55);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(7, 23, 40, 0.94), rgba(5, 17, 31, 0.94));
  padding: 32rpx 28rpx 56rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  overflow: visible;
  width: 100%;
}

.learn-topic::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(25, 182, 200, 0.025), transparent 45%);
  pointer-events: none;
}

.learn-topic__icon {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(29, 207, 205, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, rgba(13, 82, 88, 0.28), rgba(6, 24, 39, 0.52));
}

.learn-topic__body {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.learn-topic__title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #f5f7fb;
  word-break: break-word;
}

.learn-topic__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #b6c3d5;
  white-space: normal;
  word-break: break-word;
}

.learn-topic__enter {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #28e0d0;
  font-size: 26rpx;
  font-weight: 500;
}

.learn-harvest {
  margin-top: 32rpx;
  border: 2rpx solid rgba(79, 108, 145, 0.45);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(7, 23, 40, 0.94), rgba(5, 17, 31, 0.94));
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.learn-harvest__title {
  font-size: 36rpx;
  font-weight: 800;
  color: #f5f7fb;
}

.learn-harvest__pills {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.learn-pill {
  min-height: 72rpx;
  height: auto;
  border: 2rpx solid rgba(23, 197, 202, 0.65);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #e8edf4;
  font-size: 24rpx;
  background: rgba(6, 27, 40, 0.55);
  padding: 16rpx 18rpx;
  min-width: 0;
}

.learn-pill text {
  flex: 1;
  min-width: 0;
  line-height: 1.3;
  white-space: normal;
}
