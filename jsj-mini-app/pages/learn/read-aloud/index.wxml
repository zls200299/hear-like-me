<view class="read-aloud-page page-with-bg">
  <page-background variant="study"></page-background>
  <view class="page-content read-aloud-content">
    <view class="read-aloud-hero">
      <view class="read-aloud-eyebrow">听见 · 认识 · 学习</view>
      <view class="read-aloud-title">点一点，听一听</view>
      <view class="read-aloud-subtitle">点击卡片，感受人工耳蜗模拟后的声音。</view>
      <view class="read-aloud-hero__art ra-svg" style="background-image: url('{{icons['hero']}}');" aria-hidden="true"></view>
    </view>

    <view wx:if="{{loading}}" class="read-aloud-state">加载中…</view>
    <block wx:elif="{{loadError}}">
      <view class="read-aloud-state">{{loadError}}</view>
      <button class="read-aloud-retry" bindtap="onRetryTap" hover-class="ra-pressed">重新加载</button>
    </block>
    <block wx:else>
      <view class="read-aloud-categories-wrap {{categoryHasMoreRight ? 'has-more-right' : ''}} {{categoryHasMoreLeft ? 'has-more-left' : ''}}" wx:if="{{categories.length}}">
        <scroll-view
          class="read-aloud-categories"
          scroll-x
          enable-flex
          enhanced
          show-scrollbar="{{false}}"
          scroll-with-animation
          scroll-into-view="{{categoryScrollIntoView}}"
          bindscroll="onCategoryScroll"
          aria-label="声音分类，可左右滑动"
        >
          <view class="read-aloud-categories__inner">
            <button
              wx:for="{{categories}}"
              wx:key="id"
              id="cat-{{item.id}}"
              class="read-aloud-category {{selectedCategory === item.id ? 'is-selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="onCategoryTap"
              hover-class="ra-pressed"
              aria-pressed="{{selectedCategory === item.id}}"
            >
              <text>{{item.name}}</text>
            </button>
          </view>
        </scroll-view>
        <view class="read-aloud-categories__fade read-aloud-categories__fade--left" wx:if="{{categoryHasMoreLeft}}" aria-hidden="true"></view>
        <view class="read-aloud-categories__fade read-aloud-categories__fade--right" wx:if="{{categoryHasMoreRight}}" aria-hidden="true"></view>
      </view>

      <view class="read-aloud-section-heading">
        <view class="read-aloud-section-title">{{categoryName}}</view>
      </view>

      <view class="read-aloud-empty" wx:if="{{!cards.length}}">该分类暂无已发布内容</view>

      <block wx:else>
        <view class="read-aloud-swiper-wrap">
          <swiper
            class="read-aloud-swiper {{cards.length === 1 ? 'is-single' : ''}}"
            current="{{cardSwiperCurrent}}"
            previous-margin="0rpx"
            next-margin="{{cards.length > 1 ? '56rpx' : '0rpx'}}"
            snap-to-edge
            bindchange="onCardSwiperChange"
            aria-label="点读卡片，左右滑动切换"
          >
            <swiper-item wx:for="{{cards}}" wx:key="id">
              <button
                class="read-aloud-card {{activeId === item.id ? 'is-playing' : ''}}"
                data-id="{{item.id}}"
                bindtap="onCardTap"
                hover-class="read-aloud-card--pressed"
                aria-label="{{item.title}}，{{activeId === item.id ? '停止播放' : '开始播放模拟声'}}"
                aria-pressed="{{activeId === item.id}}"
              >
                <view class="read-aloud-card__media">
                  <image
                    wx:if="{{item.imageUrl}}"
                    class="read-aloud-card__image"
                    src="{{item.imageUrl}}"
                    mode="aspectFill"
                  />
                  <view
                    wx:else
                    class="read-aloud-card__placeholder"
                  >
                    <view
                      class="ra-svg read-aloud-card__illustration"
                      style="background-image: url('{{icons.hello}}');"
                      aria-hidden="true"
                    ></view>
                  </view>
                </view>
                <view class="read-aloud-card__body">
                  <view class="read-aloud-card__title">{{item.title}}</view>
                  <view class="read-aloud-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
                  <view class="read-aloud-card__footer">
                    <view class="read-aloud-card__action">
                      <view wx:if="{{activeId === item.id}}" class="read-aloud-wave" aria-hidden="true">
                        <view wx:for="{{waveBars}}" wx:key="*this" wx:for-item="bar" class="read-aloud-wave__bar read-aloud-wave__bar--{{bar}}"></view>
                      </view>
                      <view wx:else class="ra-svg read-aloud-card__play" style="background-image: url('{{icons.play}}');" aria-hidden="true"></view>
                      <text>{{activeId === item.id ? '播放中' : '点击聆听'}}</text>
                    </view>
                    <view class="read-aloud-card__status" wx:if="{{activeId === item.id}}">模拟声</view>
                    <view class="ra-svg read-aloud-card__sound" wx:else style="background-image: url('{{icons.wave}}');" aria-hidden="true"></view>
                  </view>
                </view>
              </button>
            </swiper-item>
          </swiper>
          <view class="read-aloud-swiper-fade" wx:if="{{cards.length > 1 && cardSwiperCurrent < cards.length - 1}}" aria-hidden="true"></view>
        </view>
        <view class="read-aloud-card-hint" wx:if="{{cards.length > 1}}">
          <text>左右滑动，查看更多声音 · {{cardSwiperCurrent + 1}} / {{cards.length}}</text>
        </view>
      </block>
    </block>
  </view>
</view>
