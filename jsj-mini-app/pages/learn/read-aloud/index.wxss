/* 远程背景由 page-background 统一加载；本页只设置前景内容。 */
.read-aloud-page.page-with-bg {
  min-height: 100vh;
  background-color: #020814;
  color: #eef5fc;
  line-height: 1.55;
}

.read-aloud-page .read-aloud-content {
  padding: 36rpx 32rpx calc(50rpx + env(safe-area-inset-bottom));
}

.read-aloud-page.has-player .read-aloud-content {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.ra-svg {
  flex-shrink: 0;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.read-aloud-page button {
  margin: 0;
  padding: 0;
  font: inherit;
  line-height: inherit;
  color: inherit;
  border-radius: 0;
  text-align: left;
  background: none;
}

.read-aloud-page button::after {
  border: 0;
}

.ra-pressed {
  opacity: .75;
}

.read-aloud-hero {
  position: relative;
  padding: 8rpx 4rpx 34rpx;
}

.read-aloud-eyebrow {
  color: #75bcbe;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.read-aloud-title {
  color: #29ddcc;
  font-size: 46rpx;
  font-weight: 750;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.read-aloud-subtitle {
  color: #a9bbcc;
  font-size: 24rpx;
  line-height: 1.8;
  margin-top: 16rpx;
}

.read-aloud-hero__art {
  position: absolute;
  width: 160rpx;
  height: 165rpx;
  right: 0;
  top: 20rpx;
  opacity: .92;
  pointer-events: none;
}

.read-aloud-categories-wrap {
  position: relative;
  margin: 30rpx 0 8rpx;
}

.read-aloud-categories {
  width: 100%;
  white-space: nowrap;
}

.read-aloud-categories__inner {
  display: inline-flex;
  align-items: stretch;
  gap: 12rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.read-aloud-page .read-aloud-category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: none;
  min-width: 210rpx;
  max-width: 280rpx;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 19rpx;
  border: 2rpx solid #2a3d51;
  background: rgba(9, 24, 40, .9);
  font-size: 23rpx;
  color: #a6b7c8;
  box-sizing: border-box;
}

.read-aloud-category__icon {
  width: 28rpx;
  height: 28rpx;
  opacity: .5;
}

.read-aloud-page .read-aloud-category.is-selected {
  color: #40e1cd;
  border-color: #23988d;
  background: #0b3338;
}

.read-aloud-category.is-selected .read-aloud-category__icon {
  opacity: 1;
}

.read-aloud-categories__fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 28rpx;
  pointer-events: none;
  z-index: 1;
}

.read-aloud-categories__fade--left {
  left: 0;
  background: linear-gradient(to right, #020814 0%, rgba(2, 8, 20, 0));
}

.read-aloud-categories__fade--right {
  right: 0;
  background: linear-gradient(to left, #020814 0%, rgba(2, 8, 20, 0));
}

.read-aloud-categories-hint {
  margin: 0 4rpx 22rpx;
  font-size: 20rpx;
  color: #7f97ab;
  letter-spacing: 1rpx;
}

.read-aloud-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 3rpx;
}

.read-aloud-section-title {
  font-size: 33rpx;
  font-weight: 650;
}

.read-aloud-count {
  color: #829caf;
  font-size: 21rpx;
}

.read-aloud-section-caption {
  margin: 7rpx 3rpx 23rpx;
  color: #8fa6bb;
  font-size: 22rpx;
}

.read-aloud-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.read-aloud-page .read-aloud-card {
  min-width: 0;
  position: relative;
  padding: 26rpx 24rpx 21rpx;
  border-radius: 27rpx;
  border: 2rpx solid #2a4054;
  background: rgba(7, 23, 38, .95);
  overflow: hidden;
}

.read-aloud-page .read-aloud-card.is-playing {
  border-color: #2bceba;
  background: rgba(10, 44, 49, .97);
  box-shadow: 0 0 26rpx rgba(29, 197, 176, .09);
}

.read-aloud-page .read-aloud-card--pressed {
  background: #10373e;
}

.read-aloud-card__art {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 148rpx;
  margin-bottom: 15rpx;
  background: radial-gradient(ellipse at center, rgba(25, 91, 99, .2), transparent 70%);
}

.read-aloud-card__illustration {
  width: 132rpx;
  height: 132rpx;
}

.read-aloud-card__title {
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

.read-aloud-card__subtitle {
  color: #91a8bc;
  font-size: 21rpx;
  text-align: center;
  margin-top: 5rpx;
  white-space: nowrap;
}

.read-aloud-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(119, 168, 185, .13);
  min-height: 46rpx;
}

.read-aloud-card__action {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #34cbbb;
  font-size: 21rpx;
}

.read-aloud-card__play {
  width: 26rpx;
  height: 26rpx;
}

.read-aloud-card__sound {
  width: 25rpx;
  height: 25rpx;
  opacity: .45;
}

.read-aloud-card__status {
  color: #84bcb9;
  font-size: 18rpx;
}

.read-aloud-wave {
  height: 26rpx;
  width: 28rpx;
  display: flex;
  gap: 3rpx;
  align-items: center;
}

.read-aloud-wave__bar {
  width: 3rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: #37deca;
  animation: ra-wave .75s ease-in-out infinite alternate;
}

.read-aloud-wave__bar--1 {
  height: 20rpx;
  animation-delay: -.2s;
}

.read-aloud-wave__bar--2 {
  height: 26rpx;
  animation-delay: -.4s;
}

.read-aloud-wave__bar--3 {
  height: 18rpx;
  animation-delay: -.1s;
}

.read-aloud-wave__bar--4 {
  height: 12rpx;
  animation-delay: -.5s;
}
@keyframes ra-wave { from {
  transform: scaleY(.45);
} to {
  transform: scaleY(1);
} }
@media (prefers-reduced-motion: reduce) { .read-aloud-wave__bar {
  animation: none;
} }

.read-aloud-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin-top: 32rpx;
  color: #8eabbb;
  font-size: 21rpx;
}

.read-aloud-tip__icon {
  width: 28rpx;
  height: 28rpx;
  opacity: .65;
}

.read-aloud-demo-note {
  color: #7e94aa;
  font-size: 19rpx;
  margin-top: 15rpx;
  text-align: center;
}

.read-aloud-player {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 24rpx calc(18rpx + env(safe-area-inset-bottom));
  z-index: 10;
  background: linear-gradient(transparent, #040e1c 25%);
}

.read-aloud-player__content {
  border: 2rpx solid #286661;
  border-radius: 25rpx;
  background: #09232d;
  padding: 20rpx 24rpx 18rpx;
  box-shadow: 0 8rpx 42rpx rgba(0, 0, 0, .35);
}

.read-aloud-player__top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.read-aloud-player__art {
  width: 66rpx;
  height: 66rpx;
}

.read-aloud-player__copy {
  flex: 1;
  min-width: 0;
}

.read-aloud-player__title {
  font-size: 28rpx;
  font-weight: 600;
}

.read-aloud-player__subtitle {
  color: #89afaF;
  font-size: 20rpx;
  margin-top: 3rpx;
}

.read-aloud-page .read-aloud-player__stop {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid #247c74;
  border-radius: 50%;
  background: #10413f;
}

.read-aloud-player__stop .ra-svg {
  width: 32rpx;
  height: 32rpx;
}

.read-aloud-player__timeline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #8fb0bb;
  font-size: 19rpx;
  margin-top: 15rpx;
  font-variant-numeric: tabular-nums;
}

.read-aloud-player__track {
  flex: 1;
  overflow: hidden;
  height: 5rpx;
  border-radius: 6rpx;
  background: #1d424b;
}

.read-aloud-player__progress {
  height: 100%;
  border-radius: inherit;
  background: #31d6c2;
  transition: width .1s linear;
}
