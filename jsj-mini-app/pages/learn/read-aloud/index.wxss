/* 远程背景由 page-background 统一加载；本页只设置前景内容。 */
.read-aloud-page.page-with-bg {
  min-height: 100vh;
  background-color: #020814;
  color: #eef5fc;
  line-height: 1.55;
}

.read-aloud-page .read-aloud-content {
  padding: 36rpx 32rpx calc(50rpx + env(safe-area-inset-bottom));
}

.ra-svg {
  flex-shrink: 0;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.read-aloud-page button {
  margin: 0;
  padding: 0;
  font: inherit;
  line-height: inherit;
  color: inherit;
  border-radius: 0;
  text-align: left;
  background: none;
}

.read-aloud-page button::after {
  border: 0;
}

.ra-pressed {
  opacity: .75;
}

.read-aloud-hero {
  position: relative;
  padding: 8rpx 4rpx 34rpx;
}

.read-aloud-eyebrow {
  color: #75bcbe;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.read-aloud-title {
  color: #29ddcc;
  font-size: 46rpx;
  font-weight: 750;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.read-aloud-subtitle {
  color: #a9bbcc;
  font-size: 24rpx;
  line-height: 1.8;
  margin-top: 16rpx;
}

.read-aloud-hero__art {
  position: absolute;
  width: 160rpx;
  height: 165rpx;
  right: 0;
  top: 20rpx;
  opacity: .92;
  pointer-events: none;
}

.read-aloud-categories-wrap {
  position: relative;
  margin: 30rpx 0 0;
}

.read-aloud-categories {
  width: 100%;
  white-space: nowrap;
}

.read-aloud-categories__inner {
  display: inline-flex;
  align-items: stretch;
  gap: 12rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.read-aloud-page .read-aloud-category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  min-width: 140rpx;
  max-width: 280rpx;
  min-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 19rpx;
  border: 2rpx solid #2a3d51;
  background: rgba(9, 24, 40, .9);
  font-size: 24rpx;
  color: #a6b7c8;
  box-sizing: border-box;
}

.read-aloud-page .read-aloud-category.is-selected {
  color: #40e1cd;
  border-color: #23988d;
  background: #0b3338;
}

.read-aloud-categories__fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 28rpx;
  pointer-events: none;
  z-index: 1;
}

.read-aloud-categories__fade--left {
  left: 0;
  background: linear-gradient(to right, #020814 0%, rgba(2, 8, 20, 0));
}

.read-aloud-categories__fade--right {
  right: 0;
  background: linear-gradient(to left, #020814 0%, rgba(2, 8, 20, 0));
}

.read-aloud-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 3rpx;
  margin: 28rpx 0 20rpx;
}

.read-aloud-section-title {
  font-size: 33rpx;
  font-weight: 650;
}

.read-aloud-swiper-wrap {
  position: relative;
  margin: 0 -4rpx;
}

.read-aloud-swiper {
  height: 820rpx;
}

.read-aloud-swiper swiper-item {
  box-sizing: border-box;
  padding-right: 18rpx;
}

.read-aloud-swiper.is-single swiper-item {
  padding-right: 0;
}

.read-aloud-swiper-fade {
  pointer-events: none;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 56rpx;
  background: linear-gradient(90deg, transparent, rgba(4, 14, 28, .55));
}

.read-aloud-card-hint {
  margin: 14rpx 0 6rpx;
  color: #7e94aa;
  font-size: 21rpx;
  text-align: center;
}

.read-aloud-page .read-aloud-card {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  min-width: 0;
  position: relative;
  padding: 0;
  border-radius: 28rpx;
  border: 2rpx solid #2a4054;
  background: rgba(7, 23, 38, .95);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.read-aloud-page .read-aloud-card.is-playing {
  border-color: #2bceba;
  background: rgba(10, 44, 49, .97);
  box-shadow: 0 0 26rpx rgba(29, 197, 176, .09);
}

.read-aloud-page .read-aloud-card--pressed {
  opacity: .92;
}

.read-aloud-card__media {
  flex: 1;
  min-height: 0;
  width: 100%;
  position: relative;
  background: #0a1c28;
}

.read-aloud-card__image {
  width: 100%;
  height: 100%;
  display: block;
}

.read-aloud-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(ellipse at center, rgba(25, 91, 99, .28), #0a1c28 72%);
}

.read-aloud-card__illustration {
  width: 200rpx;
  height: 200rpx;
  opacity: .9;
}

.read-aloud-card__body {
  flex-shrink: 0;
  padding: 22rpx 28rpx 24rpx;
  background: rgba(7, 23, 38, .98);
}

.read-aloud-card__title {
  font-size: 34rpx;
  font-weight: 650;
  text-align: left;
  line-height: 1.35;
}

.read-aloud-card__subtitle {
  color: #91a8bc;
  font-size: 23rpx;
  text-align: left;
  margin-top: 8rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.read-aloud-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(119, 168, 185, .13);
  min-height: 46rpx;
}

.read-aloud-card__action {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #34cbbb;
  font-size: 21rpx;
}

.read-aloud-card__play {
  width: 26rpx;
  height: 26rpx;
}

.read-aloud-card__sound {
  width: 25rpx;
  height: 25rpx;
  opacity: .45;
}

.read-aloud-card__status {
  color: #84bcb9;
  font-size: 18rpx;
}

.read-aloud-wave {
  height: 26rpx;
  width: 28rpx;
  display: flex;
  gap: 3rpx;
  align-items: center;
}

.read-aloud-wave__bar {
  width: 3rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: #37deca;
  animation: ra-wave .75s ease-in-out infinite alternate;
}

.read-aloud-wave__bar--1 {
  height: 20rpx;
  animation-delay: -.2s;
}

.read-aloud-wave__bar--2 {
  height: 26rpx;
  animation-delay: -.4s;
}

.read-aloud-wave__bar--3 {
  height: 18rpx;
  animation-delay: -.1s;
}

.read-aloud-wave__bar--4 {
  height: 12rpx;
  animation-delay: -.5s;
}
@keyframes ra-wave { from {
  transform: scaleY(.45);
} to {
  transform: scaleY(1);
} }
@media (prefers-reduced-motion: reduce) { .read-aloud-wave__bar {
  animation: none;
} }

.read-aloud-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin-top: 32rpx;
  color: #8eabbb;
  font-size: 21rpx;
}

.read-aloud-tip__icon {
  width: 28rpx;
  height: 28rpx;
  opacity: .65;
}

.read-aloud-state {
  color: #9bb0c4;
  font-size: 26rpx;
  text-align: center;
  padding: 80rpx 24rpx 24rpx;
}

.read-aloud-retry {
  display: block;
  width: 240rpx;
  margin: 0 auto;
  padding: 16rpx 0;
  border: 2rpx solid #247c74;
  border-radius: 999rpx;
  background: #10413f;
  color: #9ee8df;
  font-size: 24rpx;
  text-align: center;
}

.read-aloud-empty {
  color: #7e94aa;
  font-size: 24rpx;
  text-align: center;
  padding: 72rpx 24rpx;
}
