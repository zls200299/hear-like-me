.simulator-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 顶部 UI（asset/顶部.html） */
.top-ui {
  background:
    radial-gradient(circle at 18% 4%, rgba(19, 199, 173, 0.1), transparent 24%),
    radial-gradient(circle at 92% 32%, rgba(42, 91, 142, 0.11), transparent 30%),
    linear-gradient(180deg, #07111f 0%, #081321 100%);
}

.top-header {
  margin-bottom: 40rpx;
}

.top-header__brand {
  margin-top: 0;
  color: #28e0c2;
  font-size: 64rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.top-header__desc {
  margin: 20rpx 0 28rpx;
  color: #aab7ca;
  font-size: 28rpx;
  line-height: 1.75;
}

.top-notice {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(247, 179, 41, 0.17);
  background: rgba(247, 179, 41, 0.07);
}

.top-notice__text {
  flex: 1;
  color: #b9c3d3;
  font-size: 26rpx;
  line-height: 1.5;
}

.top-card {
  margin-top: 36rpx;
  padding: 36rpx;
  border: 1rpx solid rgba(111, 136, 167, 0.35);
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(16, 29, 47, 0.95), rgba(12, 23, 38, 0.95));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.top-card__title {
  font-size: 40rpx;
  font-weight: 800;
  color: #f4f7fb;
  margin-bottom: 32rpx;
}

.source-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.source-btn {
  min-height: 180rpx;
  padding: 24rpx 12rpx 20rpx;
  border: 1rpx solid #405066;
  border-radius: 28rpx;
  background: rgba(12, 23, 38, 0.65);
  color: #aab7ca;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.18s ease;
}

.source-btn__label {
  font-size: 32rpx;
  line-height: 1.2;
  text-align: center;
}

.source-btn--active {
  color: #28e0c2;
  border-color: #28e0c2;
  background: linear-gradient(180deg, rgba(24, 78, 78, 0.52), rgba(16, 54, 61, 0.72));
  box-shadow: 0 0 0 1rpx rgba(40, 224, 194, 0.15), 0 0 48rpx rgba(40, 224, 194, 0.12);
}

.source-detail {
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(91, 119, 151, 0.25);
  border-radius: 28rpx;
  background: rgba(6, 17, 29, 0.42);
}

.source-detail__head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #f4f7fb;
}

.source-detail__error {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #f2895e;
  background: rgba(242, 137, 94, 0.1);
  border: 1rpx solid rgba(242, 137, 94, 0.25);
}

.source-detail__upload {
  margin-top: 20rpx;
}

.source-detail__upload-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.source-detail__upload-row--loading {
  color: #8fe8d8;
}

.source-detail__upload-row--success {
  color: #2FE0C3;
  font-weight: 600;
}

.source-detail__upload-row--error {
  color: #FF7A6B;
  font-weight: 600;
}

.source-detail__upload-mark {
  flex-shrink: 0;
  width: 28rpx;
  text-align: center;
  font-weight: 700;
}

.source-detail__upload-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.source-detail__upload-spinner {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  border: 3rpx solid rgba(143, 232, 216, 0.25);
  border-top-color: #28e0c2;
  border-radius: 50%;
  animation: source-action-spin 0.7s linear infinite;
}

.source-detail__upload-fail {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 122, 107, 0.08);
  border: 1rpx solid rgba(255, 122, 107, 0.28);
}

.source-detail__upload-file {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #aab7ca;
  word-break: break-all;
}

.source-detail__upload-reason {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #FF7A6B;
}

.source-detail__samples {
  margin-top: 24rpx;
}

.source-detail__samples-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.source-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(82, 100, 123, 0.55);
  background: rgba(12, 23, 38, 0.72);
  color: #aab7ca;
  font-size: 24rpx;
  line-height: 1.4;
}

.source-chip--active {
  color: #28e0c2;
  border-color: rgba(40, 224, 194, 0.55);
  background: rgba(40, 224, 194, 0.12);
}

.source-detail__mic {
  margin: 20rpx 0 12rpx;
}

.source-detail__mic-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  color: #aab7ca;
  font-size: 26rpx;
  line-height: 1.4;
}

.source-detail__dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(40, 224, 194, 0.45);
}

.source-detail__dot--live {
  background: #28e0c2;
  box-shadow: 0 0 20rpx rgba(40, 224, 194, 0.75);
  animation: source-dot-pulse 1.2s ease-in-out infinite;
}

@keyframes source-dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.72; transform: scale(0.92); }
}

.mic-level-canvas {
  display: block;
  width: 100%;
  height: 56rpx;
}

.source-detail__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.source-detail__hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  color: #71819a;
  font-size: 26rpx;
  line-height: 1.4;
}

.source-detail__action {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  border: 1rpx solid #53647a;
  background: rgba(13, 25, 41, 0.8);
  color: #eef4fb;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.source-detail__action--start {
  border-color: transparent;
  background: linear-gradient(135deg, #32e0c7 0%, #19c8af 100%);
  color: #06141c;
  font-weight: 700;
  box-shadow: 0 12rpx 36rpx rgba(23, 200, 175, 0.2);
}

.source-detail__action--connecting {
  border-color: rgba(40, 224, 194, 0.35);
  background: rgba(40, 224, 194, 0.12);
  color: #8fe8d8;
}

.source-detail__action--stop {
  border-color: rgba(242, 137, 94, 0.55);
  background: rgba(242, 137, 94, 0.1);
  color: #ffb38f;
  font-weight: 600;
}

.source-detail__action--disabled {
  opacity: 0.72;
}

.source-detail__action--pressed {
  transform: scale(0.97);
  opacity: 0.88;
}

.source-detail__action-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(143, 232, 216, 0.25);
  border-top-color: #28e0c2;
  border-radius: 50%;
  animation: source-action-spin 0.7s linear infinite;
}

@keyframes source-action-spin {
  to { transform: rotate(360deg); }
}

.source-detail__debug {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.source-detail__debug-line {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.42);
}

.listen-card {
  padding-bottom: 40rpx;
}

.listen-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.play-btn {
  min-height: 144rpx;
  border-radius: 28rpx;
  border: 1rpx solid #52647b;
  background: rgba(12, 23, 38, 0.72);
  color: #f7f9fc;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  transition: all 0.18s ease;
}

.play-btn--primary {
  border-color: transparent;
  background: linear-gradient(135deg, #32e0c7 0%, #19c8af 100%);
  color: #06141c;
  box-shadow: 0 20rpx 60rpx rgba(23, 200, 175, 0.18);
}

.play-btn--active {
  box-shadow: 0 0 0 1rpx rgba(40, 224, 194, 0.45), 0 0 36rpx rgba(40, 224, 194, 0.22);
}

.play-btn--disabled {
  opacity: 0.45;
}

.play-btn__spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(6, 20, 28, 0.18);
  border-top-color: #06141c;
  border-radius: 50%;
  animation: play-btn-spin 0.7s linear infinite;
  flex-shrink: 0;
}

@keyframes play-btn-spin {
  to { transform: rotate(360deg); }
}

.processed-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  min-height: 40rpx;
}

.processed-status__text {
  color: #8fa0ba;
  font-size: 26rpx;
  line-height: 1.5;
}

.processed-status--playing .processed-status__text {
  color: #9debd9;
}

.processed-status--error .processed-status__text {
  color: #ffb38f;
}

.processed-status__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.processed-status__dot--pending {
  border: 2rpx solid rgba(143, 160, 186, 0.45);
  border-top-color: #28e0c2;
  animation: play-btn-spin 0.8s linear infinite;
  box-sizing: border-box;
}

.processed-status__dot--live {
  background: #28e0c2;
  box-shadow: 0 0 12rpx rgba(40, 224, 194, 0.55);
}

.processed-status__dot--error {
  background: #f2895e;
}

.listen-hint--top {
  margin-top: 20rpx;
}

/* 中部 UI（asset/中部.html） */
.mid-card {
  margin-top: 32rpx;
  padding: 36rpx;
  border: 1rpx solid rgba(111, 136, 167, 0.36);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 85% 10%, rgba(41, 109, 139, 0.05), transparent 34%),
    linear-gradient(180deg, rgba(16, 29, 47, 0.96), rgba(12, 23, 38, 0.97));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.03), 0 20rpx 48rpx rgba(0, 0, 0, 0.12);
}

.mid-card__title {
  margin-bottom: 32rpx;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #f4f7fb;
}

.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.scene-btn {
  min-height: 116rpx;
  border: 1rpx solid #43536a;
  border-radius: 28rpx;
  background: rgba(15, 27, 44, 0.75);
  color: #93a4bf;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  transition: all 0.16s ease;
}

.scene-btn--active {
  color: #2fe0c3;
  border-color: #2fe0c3;
  background: linear-gradient(180deg, rgba(43, 115, 112, 0.38), rgba(22, 74, 77, 0.46));
  box-shadow:
    0 0 0 1rpx rgba(47, 224, 195, 0.08),
    0 0 40rpx rgba(47, 224, 195, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.channel-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.channel-display {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: #2fe0c3;
}

.channel-display__num {
  font-size: 68rpx;
  line-height: 1;
  font-weight: 800;
}

.channel-display__unit {
  font-size: 30rpx;
  font-weight: 600;
  color: #7f91aa;
}

.slider-shell {
  position: relative;
  height: 68rpx;
  display: flex;
  align-items: center;
  margin: 4rpx 0 24rpx;
}

.slider-shell--compact {
  margin: 0;
}

.slider-shell__track {
  position: absolute;
  left: 0;
  right: 0;
  height: 8rpx;
  border-radius: 999rpx;
  background: #313e52;
}

.slider-shell__progress {
  position: absolute;
  left: 0;
  height: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #39e4c8, #23cbb2);
  pointer-events: none;
}

.slider-shell__control {
  position: relative;
  z-index: 2;
  width: 100%;
  margin: 0;
}

.channel-buttons {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}

.channel-btn {
  min-height: 92rpx;
  border: 1rpx solid #43536a;
  border-radius: 28rpx;
  background: rgba(15, 27, 44, 0.75);
  color: #93a4bf;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.16s ease;
}

.channel-btn--active {
  color: #2fe0c3;
  border-color: #2fe0c3;
  background: linear-gradient(180deg, rgba(43, 115, 112, 0.38), rgba(22, 74, 77, 0.46));
  box-shadow:
    0 0 0 1rpx rgba(47, 224, 195, 0.08),
    0 0 40rpx rgba(47, 224, 195, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.help-text {
  margin-top: 26rpx;
  color: #74859f;
  font-size: 26rpx;
  line-height: 1.55;
}

.mid-card .param-row {
  padding: 32rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.mid-card .param-row:first-of-type {
  border-top: none;
  padding-top: 0;
}

.param-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

.mid-card .param-label {
  color: #8fa0ba;
  font-size: 30rpx;
  margin-bottom: 0;
}

.segment {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.mid-option-btn {
  min-height: 100rpx;
  border: 1rpx solid #43536a;
  border-radius: 28rpx;
  background: rgba(15, 27, 44, 0.75);
  color: #93a4bf;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.16s ease;
}

.mid-option-btn--active {
  color: #2fe0c3;
  border-color: #2fe0c3;
  background: linear-gradient(180deg, rgba(43, 115, 112, 0.38), rgba(22, 74, 77, 0.46));
  box-shadow:
    0 0 0 1rpx rgba(47, 224, 195, 0.08),
    0 0 40rpx rgba(47, 224, 195, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.freq-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.freq-btn {
  min-height: 96rpx;
  width: 100%;
  border: 1rpx solid #43536a;
  border-radius: 28rpx;
  background: rgba(15, 27, 44, 0.75);
  color: #93a4bf;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.16s ease;
}

.freq-btn--active {
  color: #2fe0c3;
  border-color: #2fe0c3;
  background: linear-gradient(180deg, rgba(43, 115, 112, 0.38), rgba(22, 74, 77, 0.46));
  box-shadow:
    0 0 0 1rpx rgba(47, 224, 195, 0.08),
    0 0 40rpx rgba(47, 224, 195, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
}

.param-slider {
  display: grid;
  grid-template-columns: 220rpx 1fr 156rpx;
  align-items: center;
  gap: 20rpx;
}

.param-slider .param-value {
  text-align: right;
  color: #2fe0c3;
  font-size: 34rpx;
  font-weight: 700;
}

/* 品牌区（旧版，保留供其他页面参考） */
.brand-section {
  margin-bottom: 8rpx;
}

.brand-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 24rpx;
  line-height: 1.6;
  color: #6C7CA3;
}

/* 选项按钮 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.option-grid--2 .option-btn {
  width: calc(50% - 8rpx);
}

.option-btn {
  min-height: 80rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.option-btn--active {
  background: rgba(53, 208, 186, 0.15);
  border-color: rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.source-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(53, 208, 186, 0.08);
  border: 1rpx solid rgba(53, 208, 186, 0.2);
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.realtime-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8EEF8;
  margin-bottom: 12rpx;
}

.realtime-card__status {
  font-size: 26rpx;
  color: #B8C5DC;
  margin-bottom: 12rpx;
}

.realtime-card__tip {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
  margin-bottom: 20rpx;
}

.realtime-card__error {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #F2895E;
  background: rgba(242, 137, 94, 0.1);
  border: 1rpx solid rgba(242, 137, 94, 0.25);
}

.realtime-card__btn {
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(53, 208, 186, 0.15);
  border: 1rpx solid rgba(53, 208, 186, 0.45);
  color: #35D0BA;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.realtime-card__btn--stop {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.14);
  color: #E8EEF8;
}

.realtime-card__active {
  margin-top: 8rpx;
}

.realtime-card__live {
  font-size: 28rpx;
  color: #35D0BA;
  margin-bottom: 12rpx;
}

.realtime-card__stats {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.42);
}

.realtime-card__stats--dev {
  color: rgba(255, 255, 255, 0.32);
  font-size: 20rpx;
}

.sub-options {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sub-options__label {
  font-size: 24rpx;
  color: #6C7CA3;
  margin-bottom: 16rpx;
}

.upload-btn {
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(53, 208, 186, 0.15);
  border: 1rpx solid rgba(53, 208, 186, 0.45);
  color: #35D0BA;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn--disabled {
  opacity: 0.6;
}

.upload-error {
  color: #F2895E;
  border-color: rgba(242, 137, 94, 0.35);
  background: rgba(242, 137, 94, 0.08);
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-row--wrap .chip-btn--freq {
  flex: 1 1 100%;
  min-width: 0;
}

.chip-btn {
  min-height: 72rpx;
  padding: 16rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-btn--active {
