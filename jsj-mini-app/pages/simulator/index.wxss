.simulator-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 品牌区 */
.brand-section {
  margin-bottom: 8rpx;
}

.brand-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 24rpx;
  line-height: 1.6;
  color: #6C7CA3;
}

/* 选项按钮 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.option-grid--2 .option-btn {
  width: calc(50% - 8rpx);
}

.option-btn {
  min-height: 80rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.option-btn--active {
  background: rgba(53, 208, 186, 0.15);
  border-color: rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.source-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(53, 208, 186, 0.08);
  border: 1rpx solid rgba(53, 208, 186, 0.2);
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.sub-options {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sub-options__label {
  font-size: 24rpx;
  color: #6C7CA3;
  margin-bottom: 16rpx;
}

.upload-btn {
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(53, 208, 186, 0.15);
  border: 1rpx solid rgba(53, 208, 186, 0.45);
  color: #35D0BA;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn--disabled {
  opacity: 0.6;
}

.upload-error {
  color: #F2895E;
  border-color: rgba(242, 137, 94, 0.35);
  background: rgba(242, 137, 94, 0.08);
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-row--wrap .chip-btn--freq {
  flex: 1 1 100%;
  min-width: 0;
}

.chip-btn {
  min-height: 72rpx;
  padding: 16rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-btn--active {
  background: rgba(53, 208, 186, 0.18);
  border-color: rgba(53, 208, 186, 0.55);
  color: #35D0BA;
  font-weight: 600;
}

/* 场景网格 */
.scenario-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.scenario-item {
  width: calc(50% - 8rpx);
  min-height: 96rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.scenario-item--active {
  background: linear-gradient(135deg, rgba(53, 208, 186, 0.2), rgba(30, 124, 194, 0.15));
  border-color: rgba(53, 208, 186, 0.5);
}

.scenario-item__name {
  font-size: 28rpx;
  font-weight: 500;
  color: #8FA3C1;
  text-align: center;
}

.scenario-item--active .scenario-item__name {
  color: #35D0BA;
  font-weight: 600;
}

/* 通道数 */
.channel-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #35D0BA;
  margin: 8rpx 0 4rpx;
  line-height: 1.2;
}

.slider-block {
  padding: 8rpx 0 16rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.quick-btn {
  min-width: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-btn--active {
  background: rgba(53, 208, 186, 0.18);
  border-color: rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.param-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6C7CA3;
}

/* 参数组 */
.param-group {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.param-group:first-of-type {
  margin-top: 12rpx;
  padding-top: 0;
  border-top: none;
}

.param-label {
  font-size: 26rpx;
  color: #8FA3C1;
  margin-bottom: 16rpx;
}

.param-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.param-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #35D0BA;
}

/* 电极阵列 */
.electrode-panel {
  margin-top: 12rpx;
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.electrode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.electrode-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

.electrode-dot--active {
  background: linear-gradient(135deg, #35D0BA, #1E7CC2);
  box-shadow: 0 0 12rpx rgba(53, 208, 186, 0.45);
}

.electrode-caption {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6C7CA3;
  text-align: center;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-row .action-btn {
  flex: 1;
}

.action-btn--primary {
  background: linear-gradient(135deg, #35D0BA, #2BB8A4);
  color: #0B1020;
}

.action-btn--secondary {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #EAF2FF;
}

.action-btn--accent {
  margin-top: 16rpx;
  background: linear-gradient(135deg, rgba(53, 208, 186, 0.35), rgba(30, 124, 194, 0.35));
  border: 1rpx solid rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.action-btn--full {
  width: 100%;
}

.action-btn--disabled {
  opacity: 0.45;
}

/* 转换结果卡片 */
.result-card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-processing {
  border-color: rgba(53, 208, 186, 0.25);
}

.result-success {
  border-color: rgba(53, 208, 186, 0.35);
  box-shadow: 0 8rpx 32rpx rgba(53, 208, 186, 0.08);
}

.result-failed {
  border-color: rgba(242, 137, 94, 0.35);
  box-shadow: 0 8rpx 32rpx rgba(242, 137, 94, 0.08);
}

.result-head {
  margin-bottom: 28rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #EAF2FF;
  line-height: 1.4;
}

.result-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.clarity-box {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.clarity-score {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
}

.clarity-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #35D0BA;
  line-height: 1;
}

.clarity-total {
  font-size: 28rpx;
  color: #6C7CA3;
  margin-left: 4rpx;
}

.clarity-info {
  flex: 1;
  min-width: 0;
}

.clarity-grade {
  font-size: 30rpx;
  font-weight: 600;
  color: #EAF2FF;
  line-height: 1.4;
}

.clarity-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.param-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.param-chip {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  color: #8FA3C1;
  line-height: 1.4;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.result-btn {
  flex: 1;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-btn--primary {
  background: linear-gradient(135deg, #35D0BA, #2BB8A4);
  color: #0B1020;
}

.result-btn--secondary {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #EAF2FF;
}

.error-message {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(242, 137, 94, 0.1);
  border: 1rpx solid rgba(242, 137, 94, 0.25);
  font-size: 24rpx;
  line-height: 1.6;
  color: #F2895E;
  word-break: break-all;
}

.error-message__title {
  font-weight: 600;
}

.error-message__detail {
  margin-top: 8rpx;
}

.result-status-hint {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #35D0BA;
}

.loading-bar {
  margin-top: 24rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.loading-bar-inner {
  width: 40%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #35D0BA, #1E7CC2);
  animation: loading-slide 1.2s ease-in-out infinite;
}

@keyframes loading-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(350%); }
}

/* 状态卡片 */
.status-card {
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #EAF2FF;
  margin-top: 8rpx;
}

.status-processing {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #35D0BA;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #35D0BA;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}
