.simulator-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 品牌区 */
.brand-section {
  margin-bottom: 8rpx;
}

.brand-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 24rpx;
  line-height: 1.6;
  color: #6C7CA3;
}

/* 选项按钮 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.option-grid--2 .option-btn {
  width: calc(50% - 8rpx);
}

.option-btn {
  min-height: 80rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.option-btn--active {
  background: rgba(53, 208, 186, 0.15);
  border-color: rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.source-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(53, 208, 186, 0.08);
  border: 1rpx solid rgba(53, 208, 186, 0.2);
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.realtime-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8EEF8;
  margin-bottom: 12rpx;
}

.realtime-card__status {
  font-size: 26rpx;
  color: #B8C5DC;
  margin-bottom: 12rpx;
}

.realtime-card__tip {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
  margin-bottom: 20rpx;
}

.realtime-card__error {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #F2895E;
  background: rgba(242, 137, 94, 0.1);
  border: 1rpx solid rgba(242, 137, 94, 0.25);
}

.realtime-card__btn {
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(53, 208, 186, 0.15);
  border: 1rpx solid rgba(53, 208, 186, 0.45);
  color: #35D0BA;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.realtime-card__btn--stop {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.14);
  color: #E8EEF8;
}

.realtime-card__active {
  margin-top: 8rpx;
}

.realtime-card__live {
  font-size: 28rpx;
  color: #35D0BA;
  margin-bottom: 12rpx;
}

.realtime-card__stats {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.42);
}

.realtime-card__stats--dev {
  color: rgba(255, 255, 255, 0.32);
  font-size: 20rpx;
}

.sub-options {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sub-options__label {
  font-size: 24rpx;
  color: #6C7CA3;
  margin-bottom: 16rpx;
}

.upload-btn {
  min-height: 80rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(53, 208, 186, 0.15);
  border: 1rpx solid rgba(53, 208, 186, 0.45);
  color: #35D0BA;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn--disabled {
  opacity: 0.6;
}

.upload-error {
  color: #F2895E;
  border-color: rgba(242, 137, 94, 0.35);
  background: rgba(242, 137, 94, 0.08);
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-row--wrap .chip-btn--freq {
  flex: 1 1 100%;
  min-width: 0;
}

.chip-btn {
  min-height: 72rpx;
  padding: 16rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-btn--active {
  background: rgba(53, 208, 186, 0.18);
  border-color: rgba(53, 208, 186, 0.55);
  color: #35D0BA;
  font-weight: 600;
}

/* 场景网格 */
.scenario-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.scenario-item {
  width: calc(50% - 8rpx);
  min-height: 96rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.scenario-item--active {
  background: linear-gradient(135deg, rgba(53, 208, 186, 0.2), rgba(30, 124, 194, 0.15));
  border-color: rgba(53, 208, 186, 0.5);
}

.scenario-item__name {
  font-size: 28rpx;
  font-weight: 500;
  color: #8FA3C1;
  text-align: center;
}

.scenario-item--active .scenario-item__name {
  color: #35D0BA;
  font-weight: 600;
}

/* 通道数 */
.channel-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #35D0BA;
  margin: 8rpx 0 4rpx;
  line-height: 1.2;
}

.slider-block {
  padding: 8rpx 0 16rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.quick-btn {
  min-width: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #8FA3C1;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-btn--active {
  background: rgba(53, 208, 186, 0.18);
  border-color: rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.param-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6C7CA3;
}

/* 参数组 */
.param-group {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.param-group:first-of-type {
  margin-top: 12rpx;
  padding-top: 0;
  border-top: none;
}

.param-label {
  font-size: 26rpx;
  color: #8FA3C1;
  margin-bottom: 16rpx;
}

.param-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.param-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #35D0BA;
}

/* 电极阵列 */
.electrode-panel {
  margin-top: 12rpx;
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.electrode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.electrode-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

.electrode-dot--active {
  background: linear-gradient(135deg, #35D0BA, #1E7CC2);
  box-shadow: 0 0 12rpx rgba(53, 208, 186, 0.45);
}

.electrode-caption {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6C7CA3;
  text-align: center;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-row .action-btn {
  flex: 1;
}

.action-btn--primary {
  background: linear-gradient(135deg, #35D0BA, #2BB8A4);
  color: #0B1020;
}

.action-btn--secondary {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #EAF2FF;
}

.action-btn--accent {
  margin-top: 16rpx;
  background: linear-gradient(135deg, rgba(53, 208, 186, 0.35), rgba(30, 124, 194, 0.35));
  border: 1rpx solid rgba(53, 208, 186, 0.5);
  color: #35D0BA;
}

.action-btn--full {
  width: 100%;
}

.action-btn--disabled {
  opacity: 0.45;
}

.action-btn--playing {
  box-shadow: 0 0 0 1px rgba(53, 208, 186, 0.45), 0 0 18rpx rgba(53, 208, 186, 0.22);
}

/* 试听控制台 */
.console-card {
  border-color: rgba(53, 208, 186, 0.18);
}

.listen-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6C7CA3;
}

.feedback-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.18);
  border: 1rpx solid rgba(53, 208, 186, 0.28);
}

.feedback-card--processing {
  border-color: rgba(53, 208, 186, 0.35);
}

.feedback-card--success {
  border-color: rgba(53, 208, 186, 0.42);
  box-shadow: 0 4rpx 20rpx rgba(53, 208, 186, 0.06);
}

.feedback-card--failed {
  border-color: rgba(242, 137, 94, 0.35);
}

.feedback-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #EAF2FF;
  margin-bottom: 20rpx;
}

.param-chips--compact {
  margin-top: 20rpx;
  margin-bottom: 0;
}

.param-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.param-chip {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  color: #8FA3C1;
  line-height: 1.4;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.result-btn {
  flex: 1;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-btn--primary {
  background: linear-gradient(135deg, #35D0BA, #2BB8A4);
  color: #0B1020;
}

.result-btn--secondary {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #EAF2FF;
}

.error-message {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(242, 137, 94, 0.1);
  border: 1rpx solid rgba(242, 137, 94, 0.25);
  font-size: 24rpx;
  line-height: 1.6;
  color: #F2895E;
  word-break: break-all;
}

.error-message__title {
  font-weight: 600;
}

.error-message__detail {
  margin-top: 8rpx;
}

.result-status-hint {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #35D0BA;
}

.loading-bar {
  margin-top: 20rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.loading-bar-inner {
  width: 40%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #35D0BA, #1E7CC2);
  animation: loading-slide 1.2s ease-in-out infinite;
}

@keyframes loading-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(350%); }
}

/* 视觉化反馈 */
.visual-card-desc {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6C7CA3;
}

.visual-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.visual-block--first {
  margin-top: 20rpx;
  padding-top: 20rpx;
}

.visual-block--last {
  margin-bottom: 0;
  padding-bottom: 4rpx;
}

.visual-block-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8FA3C1;
  margin-bottom: 16rpx;
}

.visual-block-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6C7CA3;
  text-align: center;
}

/* 可懂度仪表 */
.clarity-meter {
  padding: 20rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.15);
}

.clarity-meter--compact {
  padding: 16rpx 0 0;
  background: transparent;
  border: none;
}

.clarity-meter-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.clarity-meter-score {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
}

.clarity-meter-num {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1;
}

.clarity-meter-total {
  font-size: 26rpx;
  color: #6C7CA3;
  margin-left: 4rpx;
}

.clarity-meter-info {
  flex: 1;
  min-width: 0;
}

.clarity-meter-grade {
  font-size: 30rpx;
  font-weight: 600;
  color: #EAF2FF;
  line-height: 1.4;
}

.clarity-meter-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.clarity-meter-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.clarity-meter-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.35s ease;
}

.clarity-meter.level-lowest .clarity-meter-num {
  color: #8B6B6B;
}

.clarity-meter.level-lowest .clarity-meter-fill {
  background: linear-gradient(90deg, #6B4545, #8B5A4A);
}

.clarity-meter.level-low .clarity-meter-num {
  color: #E89B6C;
}

.clarity-meter.level-low .clarity-meter-fill {
  background: linear-gradient(90deg, #C46B3A, #E89B6C);
}

.clarity-meter.level-mid .clarity-meter-num {
  color: #E8C46C;
}

.clarity-meter.level-mid .clarity-meter-fill {
  background: linear-gradient(90deg, #B8942E, #E8C46C);
}

.clarity-meter.level-good .clarity-meter-num {
  color: #5ECFC0;
}

.clarity-meter.level-good .clarity-meter-fill {
  background: linear-gradient(90deg, #2A9E8F, #5ECFC0);
}

.clarity-meter.level-best .clarity-meter-num {
  color: #6EFFC8;
}

.clarity-meter.level-best .clarity-meter-fill {
  background: linear-gradient(90deg, #35D0BA, #6EFFC8);
  box-shadow: 0 0 16rpx rgba(53, 208, 186, 0.35);
}

/* 电极条阵列 */
.electrode-array-wrap {
  padding: 8rpx 0 4rpx;
}

.electrode-array {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.electrode-row {
  width: 100%;
}

.electrode-row-track {
  position: relative;
  height: 18rpx;
  border-radius: 9rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.electrode-row-fill {
  height: 100%;
  min-width: 4%;
  border-radius: 9rpx;
  transition: width 0.08s linear, opacity 0.08s linear;
}

.electrode-row-fill--glow {
  box-shadow: 0 0 14rpx rgba(53, 208, 186, 0.45);
}

.electrode-row-fill-0 {
  background: linear-gradient(90deg, #2B2E83, #3A3F9E);
}

.electrode-row-fill-1 {
  background: linear-gradient(90deg, #1E5FA8, #1E7CC2);
}

.electrode-row-fill-2 {
  background: linear-gradient(90deg, #128F86, #16B9A6);
}

.electrode-row-fill-3 {
  background: linear-gradient(90deg, #35D0BA, #5ED9C5);
}

.electrode-row-fill-4 {
  background: linear-gradient(90deg, #5CB832, #7DC93F);
}

.electrode-row-fill-5 {
  background: linear-gradient(90deg, #9BB82E, #C4D43A);
}

.electrode-row-fill-6 {
  background: linear-gradient(90deg, #D9A82E, #F2C14E);
}

.electrode-row-fill-7 {
  background: linear-gradient(90deg, #E89B4A, #F2A65A);
}

.visual-meta {
  margin-top: 12rpx;
}

/* 电极视觉增强（旧点阵保留供兼容） */
.electrode-panel--visual {
  margin-top: 0;
  padding: 20rpx 16rpx;
}

.electrode-visual-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
}

.electrode-dot--inactive {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.electrode-dot--active {
  background: linear-gradient(135deg, #35D0BA, #1E7CC2);
}

.electrode-dot--spread-low.electrode-dot--active {
  box-shadow: 0 0 10rpx rgba(53, 208, 186, 0.35);
}

.electrode-dot--spread-mid.electrode-dot--active {
  box-shadow: 0 0 18rpx rgba(53, 208, 186, 0.5);
}

.electrode-dot--spread-high.electrode-dot--active {
  box-shadow: 0 0 28rpx rgba(53, 208, 186, 0.65), 0 0 48rpx rgba(30, 124, 194, 0.25);
}

.electrode-dot--pulse {
  animation: pulseGlow 1.1s ease-in-out infinite;
}

.electrode-dot--weak-pulse {
  animation: pulseGlow 2s ease-in-out infinite;
  opacity: 0.75;
}

.electrode-dot--noise {
  animation: pulseGlow 1.1s ease-in-out infinite, noiseFlicker 0.45s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% {
    transform: scale(1);
    filter: brightness(1);
  }
  50% {
    transform: scale(1.15);
    filter: brightness(1.25);
  }
}

@keyframes noiseFlicker {
  0%, 100% { opacity: 0.85; }
  50% { opacity: 1; }
}

/* 神经活动滚动图 */
.neuro-canvas-wrap {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(12, 18, 32, 1);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.neuro-canvas {
  display: block;
  width: 100%;
  height: 220rpx;
}
