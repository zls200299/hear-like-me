}

.electrode-row-fill-2 {
  background: linear-gradient(90deg, #128F86, #16B9A6);
}

.electrode-row-fill-3 {
  background: linear-gradient(90deg, #35D0BA, #5ED9C5);
}

.electrode-row-fill-4 {
  background: linear-gradient(90deg, #5CB832, #7DC93F);
}

.electrode-row-fill-5 {
  background: linear-gradient(90deg, #9BB82E, #C4D43A);
}

.electrode-row-fill-6 {
  background: linear-gradient(90deg, #D9A82E, #F2C14E);
