/* 电极视觉增强（旧点阵保留供兼容） */
.electrode-panel--visual {
  margin-top: 0;
  padding: 20rpx 16rpx;
}

.electrode-visual-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
}

.electrode-dot--inactive {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.electrode-dot--active {
  background: linear-gradient(135deg, #35D0BA, #1E7CC2);
}

.electrode-dot--spread-low.electrode-dot--active {
  box-shadow: 0 0 10rpx rgba(53, 208, 186, 0.35);
}

.electrode-dot--spread-mid.electrode-dot--active {
  box-shadow: 0 0 18rpx rgba(53, 208, 186, 0.5);
}

.electrode-dot--spread-high.electrode-dot--active {
  box-shadow: 0 0 28rpx rgba(53, 208, 186, 0.65), 0 0 48rpx rgba(30, 124, 194, 0.25);
}

.electrode-dot--pulse {
  animation: pulseGlow 1.1s ease-in-out infinite;
}

.electrode-dot--weak-pulse {
  animation: pulseGlow 2s ease-in-out infinite;
  opacity: 0.75;
}

.electrode-dot--noise {
  animation: pulseGlow 1.1s ease-in-out infinite, noiseFlicker 0.45s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% {
    transform: scale(1);
    filter: brightness(1);
  }
  50% {
    transform: scale(1.15);
    filter: brightness(1.25);
  }
}

@keyframes noiseFlicker {
  0%, 100% { opacity: 0.85; }
  50% { opacity: 1; }
}

