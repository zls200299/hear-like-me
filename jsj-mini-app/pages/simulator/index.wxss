/* 可懂度仪表 */
.clarity-meter {
  padding: 20rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.15);
}

.clarity-meter--compact {
  padding: 16rpx 0 0;
  background: transparent;
  border: none;
}

.clarity-meter-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.clarity-meter-score {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
}

.clarity-meter-num {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1;
}

.clarity-meter-total {
  font-size: 26rpx;
  color: #6C7CA3;
  margin-left: 4rpx;
}

.clarity-meter-info {
  flex: 1;
  min-width: 0;
}

.clarity-meter-grade {
  font-size: 30rpx;
  font-weight: 600;
  color: #EAF2FF;
  line-height: 1.4;
}

.clarity-meter-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.clarity-meter-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.clarity-meter-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.35s ease;
}

.clarity-meter.level-lowest .clarity-meter-num {
  color: #8B6B6B;
}

.clarity-meter.level-lowest .clarity-meter-fill {
  background: linear-gradient(90deg, #6B4545, #8B5A4A);
}

.clarity-meter.level-low .clarity-meter-num {
  color: #E89B6C;
}

.clarity-meter.level-low .clarity-meter-fill {
  background: linear-gradient(90deg, #C46B3A, #E89B6C);
}

.clarity-meter.level-mid .clarity-meter-num {
  color: #E8C46C;
}

.clarity-meter.level-mid .clarity-meter-fill {
  background: linear-gradient(90deg, #B8942E, #E8C46C);
}

.clarity-meter.level-good .clarity-meter-num {
  color: #5ECFC0;
}

.clarity-meter.level-good .clarity-meter-fill {
  background: linear-gradient(90deg, #2A9E8F, #5ECFC0);
}

.clarity-meter.level-best .clarity-meter-num {
  color: #6EFFC8;
}

.clarity-meter.level-best .clarity-meter-fill {
  background: linear-gradient(90deg, #35D0BA, #6EFFC8);
  box-shadow: 0 0 16rpx rgba(53, 208, 186, 0.35);
