<view class="page safe-bottom simulator-page top-ui">
  <view class="top-header">
    <view class="top-header__brand">hear like me</view>
    <view class="top-header__desc">选择声音，调整参数，体验人工耳蜗的听觉呈现效果。</view>
    <view class="top-notice">
      <hlm-icon name="warning" size="40" color="#f7b329" />
      <text class="top-notice__text">本工具仅用于科普体验，不代表真实医疗效果。</text>
    </view>
  </view>

  <view class="top-card">
    <view class="top-card__title">音频来源</view>
    <view class="source-grid">
      <view
        wx:for="{{sourceOptions}}"
        wx:key="type"
        class="source-btn {{sourceType === item.type ? 'source-btn--active' : ''}}"
        data-type="{{item.type}}"
        bindtap="selectSource"
      >
        <hlm-icon
          name="{{item.type === 'sample' ? 'music' : (item.type === 'upload' ? 'upload' : 'microphone')}}"
          size="56"
          color="{{sourceType === item.type ? '#28e0c2' : '#aab7ca'}}"
        />
        <text class="source-btn__label">{{item.label}}</text>
      </view>
    </view>

    <view class="source-detail">
      <view class="source-detail__head">
        <hlm-icon name="{{sourceDetailIcon}}" size="42" color="#a4b2c7" />
        <text>{{sourceDetailTitle}}</text>
      </view>

      <view wx:if="{{realtimeError && sourceType === 'realtime'}}" class="source-detail__error">{{realtimeError}}</view>

      <view wx:if="{{sourceType === 'sample'}}" class="source-detail__samples">
        <view class="source-detail__samples-row">
          <view
            wx:for="{{sampleOptions}}"
            wx:key="code"
            class="source-chip {{selectedSample === item.code ? 'source-chip--active' : ''}}"
            data-code="{{item.code}}"
            bindtap="selectSample"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view wx:if="{{sourceType === 'realtime'}}" class="source-detail__mic">
        <view class="source-detail__mic-status">
          <view class="source-detail__dot {{realtimeRecording ? 'source-detail__dot--live' : ''}}"></view>
          <text>{{realtimeMicStatusLabel}}</text>
        </view>
        <canvas
          type="2d"
          id="micLevelCanvas"
          class="mic-level-canvas"
        ></canvas>
      </view>

      <view class="source-detail__footer">
        <view class="source-detail__hint">
          <hlm-icon name="headphones" size="36" color="#71819a" />
          <text>{{sourceDetailHint}}</text>
        </view>
        <view
          wx:if="{{sourceDetailShowAction}}"
          class="source-detail__action source-detail__action--{{sourceDetailActionTone}} {{sourceDetailActionDisabled ? 'source-detail__action--disabled' : ''}}"
          hover-class="{{sourceDetailActionDisabled ? '' : 'source-detail__action--pressed'}}"
          hover-stay-time="80"
          bindtap="onSourceDetailAction"
        >
          <view wx:if="{{sourceDetailActionTone === 'connecting'}}" class="source-detail__action-spinner"></view>
          <text>{{sourceDetailActionLabel}}</text>
        </view>
      </view>

      <view wx:if="{{showRealtimeDebug && sourceType === 'realtime'}}" class="source-detail__debug">
        <view class="source-detail__debug-line">已接收帧：{{realtimeFrameCount}}</view>
        <view class="source-detail__debug-line">最近一帧：{{realtimeLastFrameBytes}} bytes</view>
        <view class="source-detail__debug-line">实时连接：{{realtimeSocketConnected ? '正常' : '未连接'}}</view>
        <view class="source-detail__debug-line">发送帧：{{realtimeSentFrames}} · 返回帧：{{realtimeReceivedFrames}}</view>
        <view class="source-detail__debug-line" wx:if="{{realtimeLastRttMs != null}}">往返延迟：{{realtimeLastRttMs}} ms（平均 {{realtimeAvgRttMs}} ms）</view>
        <view class="source-detail__debug-line" wx:if="{{realtimeLostFrames > 0}}">丢帧：{{realtimeLostFrames}}</view>
      </view>
    </view>
  </view>

  <view class="top-card listen-card">
    <view class="top-card__title">试听</view>
    <view class="listen-actions">
      <view
        class="play-btn {{isAudioPlaying && playingKind === 'original' ? 'play-btn--active' : ''}}"
        bindtap="playOriginal"
      >
        <hlm-icon
          name="waveform"
          size="48"
          color="{{isAudioPlaying && playingKind === 'original' ? '#28e0c2' : '#f7f9fc'}}"
        />
        <text>{{isAudioPlaying && playingKind === 'original' ? '停止原声' : '播放原声'}}</text>
      </view>
      <view
        class="play-btn play-btn--primary {{isProcessing ? 'play-btn--disabled' : ''}} {{isAudioPlaying && playingKind === 'processed' ? 'play-btn--active' : ''}}"
        bindtap="playProcessedAuto"
      >
        <hlm-icon
          name="waveform"
          size="48"
          color="{{isAudioPlaying && playingKind === 'processed' ? '#28e0c2' : '#06141c'}}"
        />
        <text>{{isProcessing ? (isAudioPlaying && playingKind === 'processed' ? '更新中...' : '正在生成...') : (isAudioPlaying && playingKind === 'processed' ? '停止模拟声' : '播放模拟声')}}</text>
      </view>
    </view>
    <view wx:if="{{listenHint}}" class="listen-hint listen-hint--top">{{listenHint}}</view>
  </view>

  <!-- 模拟场景 -->
  <view class="mid-card">
    <view class="mid-card__title">模拟场景</view>
    <view class="scene-grid">
      <view
        wx:for="{{scenarioList}}"
        wx:key="code"
        class="scene-btn {{selectedScenario === item.code ? 'scene-btn--active' : ''}}"
        data-code="{{item.code}}"
        bindtap="selectScenario"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 有效通道数 -->
  <view class="mid-card">
    <view class="mid-card__title">有效通道数</view>
    <view class="channel-top">
      <view class="channel-display">
        <text class="channel-display__num">{{nChannels}}</text>
        <text class="channel-display__unit">通道</text>
      </view>
    </view>
    <view class="slider-shell">
      <view class="slider-shell__track"></view>
      <view class="slider-shell__progress" style="width: {{channelSliderPct}}%;"></view>
      <slider
        class="slider-shell__control"
        min="1"
        max="22"
        step="1"
        value="{{nChannels}}"
        activeColor="transparent"
        backgroundColor="transparent"
        block-color="#2cceb2"
        block-size="24"
        bindchange="changeChannels"
        bindchanging="onChannelsChanging"
      />
    </view>
    <view class="channel-buttons">
      <view
        wx:for="{{channelQuickValues}}"
        wx:key="*this"
        class="channel-btn {{nChannels === item ? 'channel-btn--active' : ''}}"
        data-value="{{item}}"
        bindtap="quickSetChannels"
      >
        {{item}}
      </view>
    </view>
    <view class="help-text">通道数越少，声音细节越少，听起来越模糊。</view>
  </view>

  <!-- 参数设置 -->
  <view class="mid-card">
    <view class="mid-card__title">参数设置</view>

    <view class="param-row">
      <view class="param-header">
        <text class="param-label">载体类型</text>
      </view>
      <view class="segment">
        <view
          class="mid-option-btn {{carrier === 'noise' ? 'mid-option-btn--active' : ''}}"
          data-value="noise"
          bindtap="selectCarrier"
        >噪声载体</view>
        <view
          class="mid-option-btn {{carrier === 'sine' ? 'mid-option-btn--active' : ''}}"
          data-value="sine"
          bindtap="selectCarrier"
        >正弦载体</view>
      </view>
    </view>

    <view class="param-row">
      <view class="param-header">
        <text class="param-label">频率范围</text>
      </view>
      <view class="freq-wrap">
        <view
          wx:for="{{frequencyOptions}}"
          wx:key="value"
          class="freq-btn {{frequencyRange === item.value ? 'freq-btn--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectFrequencyRange"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="param-row">
      <view class="param-slider">
        <text class="param-label">包络细节</text>
        <view class="slider-shell slider-shell--compact">
          <view class="slider-shell__track"></view>
          <view class="slider-shell__progress" style="width: {{envCutSliderPct}}%;"></view>
          <slider
            class="slider-shell__control"
            min="20"
            max="500"
            step="10"
            value="{{envCut}}"
            activeColor="transparent"
            backgroundColor="transparent"
            block-color="#2cceb2"
            block-size="24"
            bindchange="changeEnvCut"
            bindchanging="onEnvCutChanging"
          />
        </view>
        <text class="param-value">{{envCut}} Hz</text>
      </view>
    </view>

    <view class="param-row">
      <view class="param-slider">
        <text class="param-label">电流扩散</text>
        <view class="slider-shell slider-shell--compact">
          <view class="slider-shell__track"></view>
          <view class="slider-shell__progress" style="width: {{spreadSliderPct}}%;"></view>
          <slider
            class="slider-shell__control"
            min="0"
            max="100"
            step="1"
            value="{{spread}}"
            activeColor="transparent"
            backgroundColor="transparent"
            block-color="#2cceb2"
            block-size="24"
            bindchange="changeSpread"
            bindchanging="onSpreadChanging"
          />
        </view>
        <text class="param-value">{{spread}}%</text>
      </view>
    </view>

    <view class="param-row">
      <view class="param-slider">
        <text class="param-label">环境噪声</text>
        <view class="slider-shell slider-shell--compact">
          <view class="slider-shell__track"></view>
          <view class="slider-shell__progress" style="width: {{noiseSliderPct}}%;"></view>
          <slider
            class="slider-shell__control"
            min="0"
            max="100"
            step="1"
            value="{{noiseLevel}}"
            activeColor="transparent"
            backgroundColor="transparent"
            block-color="#2cceb2"
            block-size="24"
            bindchange="changeNoiseLevel"
            bindchanging="onNoiseLevelChanging"
          />
        </view>
        <text class="param-value">{{noiseLevel}}%</text>
      </view>
    </view>
  </view>

  <!-- 当前模拟反馈 -->
  <view class="card console-card">
    <view class="card-title">当前模拟反馈</view>

    <view class="feedback-card {{clarityLevelClass}} {{taskStatus === 'failed' ? 'feedback-card--failed' : ''}} {{taskStatus === 'success' ? 'feedback-card--success' : ''}} {{taskStatus === 'processing' ? 'feedback-card--processing' : ''}}">

      <view class="clarity-meter clarity-meter--compact {{clarityLevelClass}}">
        <view class="clarity-meter-main">
          <view class="clarity-meter-score">
            <text class="clarity-meter-num">{{clarityScore != null ? clarityScore : '--'}}</text>
            <text class="clarity-meter-total">/100</text>
          </view>
          <view class="clarity-meter-info">
            <view class="clarity-meter-grade">{{clarityGrade || '参数估算'}}</view>
            <view class="clarity-meter-desc">{{clarityDesc}}</view>
          </view>
        </view>
        <view class="clarity-meter-track">
          <view
            class="clarity-meter-fill"
            style="width: {{clarityScore != null ? clarityScore : 0}}%;"
          ></view>
        </view>
      </view>

      <view class="param-chips param-chips--compact">
        <view class="param-chip">通道 {{nChannels}}</view>
        <view class="param-chip">{{carrier === 'noise' ? '噪声载体' : '正弦载体'}}</view>
        <view class="param-chip">{{frequencyRange}} Hz</view>
        <view class="param-chip">包络 {{envCut}} Hz</view>
        <view class="param-chip">扩散 {{spread}}%</view>
        <view class="param-chip">噪声 {{noiseLevel}}%</view>
      </view>

      <view wx:if="{{taskStatus === 'processing'}}" class="loading-bar">
        <view class="loading-bar-inner"></view>
      </view>

      <view wx:if="{{taskStatus === 'failed'}}" class="error-message">
        <view class="error-message__title">模拟声音生成失败</view>
        <view wx:if="{{errorMessage}}" class="error-message__detail">失败原因：{{errorMessage}}</view>
      </view>
    </view>
  </view>

  <!-- 视觉化反馈 -->
  <view class="card visual-card">
    <view class="card-title">视觉化反馈</view>
    <view class="visual-card-desc">模拟声播放时，电极阵列会根据各频率通道的活动强度实时变化，仅用于科普展示。</view>

    <simulator-visual
      id="visualPanel"
      nChannels="{{nChannels}}"
      spread="{{spread}}"
      carrier="{{carrier}}"
      noiseLevel="{{noiseLevel}}"
      envCut="{{envCut}}"
      frequencyRange="{{frequencyRange}}"
      isAudioPlaying="{{isAudioPlaying}}"
      playingKind="{{playingKind}}"
      audioSeekSec="{{audioSeekSec}}"
      realtimeActive="{{(sourceType === 'realtime' && realtimeRecording) || fileStreamingActive}}"
    />
  </view>
</view>
