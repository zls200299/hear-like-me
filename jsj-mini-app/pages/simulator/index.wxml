<view class="page safe-bottom simulator-page">
  <!-- 品牌介绍区 -->
  <view class="brand-section">
    <view class="page-title">hear like me</view>
    <view class="page-subtitle">人工耳蜗听觉模拟</view>
    <view class="page-desc">选择声音，调整通道数和场景参数，体验人工耳蜗声音模拟效果。</view>
    <view class="brand-tip">本工具仅用于科普体验，不代表任何个体真实听觉效果。</view>
  </view>

  <!-- 音频来源 -->
  <view class="card">
    <view class="card-title">音频来源</view>
    <view class="option-grid option-grid--2">
      <view
        wx:for="{{sourceOptions}}"
        wx:key="type"
        class="option-btn {{sourceType === item.type ? 'option-btn--active' : ''}}"
        data-type="{{item.type}}"
        bindtap="selectSource"
      >
        {{item.label}}
      </view>
    </view>

    <view wx:if="{{sourceHint && sourceType !== 'upload'}}" class="source-hint">{{sourceHint}}</view>

    <view wx:if="{{sourceType === 'sample'}}" class="sub-options">
      <view class="sub-options__label">选择示例</view>
      <view class="option-row">
        <view
          wx:for="{{sampleOptions}}"
          wx:key="code"
          class="chip-btn {{selectedSample === item.code ? 'chip-btn--active' : ''}}"
          data-code="{{item.code}}"
          bindtap="selectSample"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view wx:if="{{sourceType === 'upload'}}" class="sub-options">
      <view wx:if="{{taskStatus === 'uploading'}}" class="source-hint">正在上传...</view>
      <view wx:elif="{{taskStatus === 'ready' && uploadedFileName}}" class="source-hint">已上传：{{uploadedFileName}}</view>
      <view wx:else class="source-hint">请选择一个 MP3/WAV/M4A/AAC 音频文件</view>
    </view>
  </view>

  <!-- 模拟场景 -->
  <view class="card">
    <view class="card-title">模拟场景</view>
    <view class="scenario-grid">
      <view
        wx:for="{{scenarioList}}"
        wx:key="code"
        class="scenario-item {{selectedScenario === item.code ? 'scenario-item--active' : ''}}"
        data-code="{{item.code}}"
        bindtap="selectScenario"
      >
        <text class="scenario-item__name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 有效通道数 -->
  <view class="card">
    <view class="card-title">有效通道数</view>
    <view class="channel-value">{{nChannels}} 通道</view>
    <view class="slider-block">
      <slider
        min="1"
        max="22"
        step="1"
        value="{{nChannels}}"
        activeColor="#35D0BA"
        backgroundColor="rgba(255,255,255,0.12)"
        block-color="#35D0BA"
        block-size="20"
        bindchange="changeChannels"
        bindchanging="onChannelsChanging"
      />
    </view>
    <view class="quick-row">
      <view
        wx:for="{{channelQuickValues}}"
        wx:key="*this"
        class="quick-btn {{nChannels === item ? 'quick-btn--active' : ''}}"
        data-value="{{item}}"
        bindtap="quickSetChannels"
      >
        {{item}}
      </view>
    </view>
    <view class="param-hint">通道数越少，声音细节越少，听起来越模糊。</view>
  </view>

  <!-- 参数设置 -->
  <view class="card">
    <view class="card-title">参数设置</view>

    <view class="param-group">
      <view class="param-label">载体类型</view>
      <view class="option-row">
        <view
          class="chip-btn {{carrier === 'noise' ? 'chip-btn--active' : ''}}"
          data-value="noise"
          bindtap="selectCarrier"
        >噪声载体</view>
        <view
          class="chip-btn {{carrier === 'sine' ? 'chip-btn--active' : ''}}"
          data-value="sine"
          bindtap="selectCarrier"
        >正弦载体</view>
      </view>
    </view>

    <view class="param-group">
      <view class="param-label">频率范围</view>
      <view class="option-row option-row--wrap">
        <view
          wx:for="{{frequencyOptions}}"
          wx:key="value"
          class="chip-btn chip-btn--freq {{frequencyRange === item.value ? 'chip-btn--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectFrequencyRange"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="param-group">
      <view class="param-label-row">
        <text class="param-label">包络细节</text>
        <text class="param-value">{{envCut}} Hz</text>
      </view>
      <view class="slider-block">
        <slider
          min="20"
          max="500"
          step="10"
          value="{{envCut}}"
          activeColor="#35D0BA"
          backgroundColor="rgba(255,255,255,0.12)"
          block-color="#35D0BA"
          block-size="20"
          bindchange="changeEnvCut"
        />
      </view>
    </view>

    <view class="param-group">
      <view class="param-label-row">
        <text class="param-label">电流扩散</text>
        <text class="param-value">{{spread}}%</text>
      </view>
      <view class="slider-block">
        <slider
          min="0"
          max="100"
          step="1"
          value="{{spread}}"
          activeColor="#35D0BA"
          backgroundColor="rgba(255,255,255,0.12)"
          block-color="#35D0BA"
          block-size="20"
          bindchange="changeSpread"
        />
      </view>
    </view>

    <view class="param-group">
      <view class="param-label-row">
        <text class="param-label">环境噪声</text>
        <text class="param-value">{{noiseLevel}}%</text>
      </view>
      <view class="slider-block">
        <slider
          min="0"
          max="100"
          step="1"
          value="{{noiseLevel}}"
          activeColor="#35D0BA"
          backgroundColor="rgba(255,255,255,0.12)"
          block-color="#35D0BA"
          block-size="20"
          bindchange="changeNoiseLevel"
        />
      </view>
    </view>
  </view>

  <!-- 试听 + 当前模拟反馈 -->
  <view class="card console-card">
    <view class="card-title">试听</view>
    <view class="action-row">
      <view
        class="action-btn action-btn--secondary {{isAudioPlaying && playingKind === 'original' ? 'action-btn--playing' : ''}}"
        bindtap="playOriginal"
      >{{isAudioPlaying && playingKind === 'original' ? '停止原声' : '播放原声'}}</view>
      <view
        class="action-btn action-btn--primary {{isProcessing ? 'action-btn--disabled' : ''}} {{isAudioPlaying && playingKind === 'processed' ? 'action-btn--playing' : ''}}"
        bindtap="playProcessedAuto"
      >{{isProcessing ? (isAudioPlaying && playingKind === 'processed' ? '更新中...' : '正在生成...') : (isAudioPlaying && playingKind === 'processed' ? '停止模拟声' : '播放模拟声')}}</view>
    </view>
    <view class="listen-hint">{{listenHint}}</view>

    <view class="feedback-card {{clarityLevelClass}} {{taskStatus === 'failed' ? 'feedback-card--failed' : ''}} {{taskStatus === 'success' ? 'feedback-card--success' : ''}} {{taskStatus === 'processing' ? 'feedback-card--processing' : ''}}">
      <view class="feedback-card__title">当前模拟反馈</view>

      <view class="clarity-meter clarity-meter--compact {{clarityLevelClass}}">
        <view class="clarity-meter-main">
          <view class="clarity-meter-score">
            <text class="clarity-meter-num">{{clarityScore != null ? clarityScore : '--'}}</text>
            <text class="clarity-meter-total">/100</text>
          </view>
          <view class="clarity-meter-info">
            <view class="clarity-meter-grade">{{clarityGrade || '参数估算'}}</view>
            <view class="clarity-meter-desc">{{clarityDesc}}</view>
          </view>
        </view>
        <view class="clarity-meter-track">
          <view
            class="clarity-meter-fill"
            style="width: {{clarityScore != null ? clarityScore : 0}}%;"
          ></view>
        </view>
      </view>

      <view class="param-chips param-chips--compact">
        <view class="param-chip">通道 {{nChannels}}</view>
        <view class="param-chip">{{carrier === 'noise' ? '噪声载体' : '正弦载体'}}</view>
        <view class="param-chip">{{frequencyRange}} Hz</view>
        <view class="param-chip">包络 {{envCut}} Hz</view>
        <view class="param-chip">扩散 {{spread}}%</view>
        <view class="param-chip">噪声 {{noiseLevel}}%</view>
      </view>

      <view wx:if="{{taskStatus === 'processing'}}" class="loading-bar">
        <view class="loading-bar-inner"></view>
      </view>

      <view wx:if="{{taskStatus === 'failed'}}" class="error-message">
        <view class="error-message__title">模拟声音生成失败</view>
        <view wx:if="{{errorMessage}}" class="error-message__detail">失败原因：{{errorMessage}}</view>
      </view>
    </view>
  </view>

  <!-- 视觉化反馈 -->
  <view class="card visual-card">
    <view class="card-title">视觉化反馈</view>
    <view class="visual-card-desc">根据当前参数模拟频率覆盖、电极激活和神经活动，仅用于科普展示。</view>

    <view class="visual-block visual-block--first">
      <view class="visual-block-title">频率覆盖</view>
      <view class="freq-track">
        <view
          class="freq-fill"
          style="left: {{freqCoverageLeft}}; width: {{freqCoverageWidth}};"
        ></view>
      </view>
      <view class="freq-label-row">
        <text class="freq-label">80Hz</text>
        <text class="freq-current">当前：{{freqCoverageLabel}}</text>
        <text class="freq-label">8000Hz</text>
      </view>
    </view>

    <view class="visual-block">
      <view class="visual-block-title">电极活动</view>
      <view class="visual-section electrode-array-wrap">
        <view class="electrode-array">
          <view
            wx:for="{{electrodeBarLevels}}"
            wx:key="index"
            class="electrode-row"
          >
            <view class="electrode-row-track">
              <view
                class="electrode-row-fill electrode-row-fill-{{item.colorIndex}} {{item.glow ? 'electrode-row-fill--glow' : ''}}"
                style="width: {{item.percent}}%; opacity: {{item.opacity}};"
              ></view>
            </view>
          </view>
        </view>
      </view>
      <view class="visual-block-hint visual-meta">激活 {{nChannels}} / 22 通道 · 扩散 {{spread}}%</view>
    </view>

    <view class="visual-block visual-block--last">
      <view class="visual-block-title">神经活动</view>
      <view class="neural-bars">
        <view
          wx:for="{{neuralBars}}"
          wx:key="index"
          class="neural-bar {{item.animClass}} {{item.flicker ? 'neural-bar--flicker' : ''}}"
          style="height: {{item.height}}; animation-delay: {{item.delay}}; animation-duration: {{item.duration}};"
        ></view>
      </view>
      <view class="visual-block-hint">
        {{carrier === 'sine' ? '正弦载体 · 规律起伏' : '噪声载体 · 随机扰动'}}
        · 包络 {{envCut}} Hz
      </view>
    </view>
  </view>
</view>
