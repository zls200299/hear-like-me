.profile-page {
  min-height: 100vh;
  background-color: #071521;
}

.profile-page.page-with-bg {
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.profile-page .page-content {
  padding: 24rpx 32rpx 0;
}

.profile-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  opacity: 0.23;
  pointer-events: none;
  z-index: 1;
  background-image:
    linear-gradient(rgba(55, 106, 133, 0.2) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(55, 106, 133, 0.18) 1rpx, transparent 1rpx);
  background-size: 76rpx 76rpx;
}

.profile-content {
  position: relative;
  z-index: 2;
}

.profile-card {
  border: 3.2rpx solid rgba(121, 146, 180, 0.24);
  background: linear-gradient(180deg, rgba(18, 34, 56, 0.94), rgba(14, 29, 48, 0.94));
  border-radius: 36rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.015);
}

.profile-login-card {
  margin-top: 16rpx;
  margin-bottom: 32rpx;
  padding: 32rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.profile-login-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.profile-login-avatar-col {
  flex: 0 0 128rpx;
  width: 128rpx;
}

.profile-avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
  width: 128rpx;
  height: 128rpx;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 28%, rgba(112, 137, 171, 0.28), transparent 48%),
    linear-gradient(180deg, #1a2940, #111e31);
  border: 4rpx solid rgba(114, 139, 173, 0.35);
}

.profile-avatar__placeholder {
  width: 92rpx;
  height: 92rpx;
}

.profile-avatar__image {
  width: 100%;
  height: 100%;
}

.profile-login-text {
  flex: 1;
  min-width: 0;
}

.profile-login-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.6rpx;
  margin-bottom: 10rpx;
  color: #f5f7fb;
  line-height: 1.2;
}

.profile-login-sub {
  color: #9cabc1;
  font-size: 26rpx;
  line-height: 1.5;
}

.profile-login-bottom {
  width: 100%;
}

.profile-wechat-btn {
  width: 100% !important;
  height: 88rpx;
  min-width: 0;
  max-width: none;
  padding: 0 32rpx;
  margin: 0;
  border: 3.6rpx solid rgba(42, 233, 218, 0.75);
  border-radius: 76rpx;
  color: #fff;
  background: linear-gradient(180deg, #27c8ce, #23b5c8);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
  box-shadow: 0 0 50rpx rgba(37, 203, 205, 0.13);
  white-space: nowrap;
}

.profile-wechat-btn::after {
  border: none;
}

.profile-wechat-btn--outline {
  width: 100% !important;
  min-width: 0;
  max-width: none;
  padding: 0 32rpx;
  background: transparent;
  color: #2bd8ca;
  box-shadow: none;
}

.profile-login-tagline {
  font-size: 26rpx;
  line-height: 1.55;
  color: #9cabc1;
  text-align: center;
  padding: 4rpx 8rpx 0;
}

.profile-logout-wrap {
  margin: 8rpx 0 40rpx;
  display: flex;
  justify-content: center;
}

.profile-logout-btn {
  font-size: 28rpx;
  line-height: 1.4;
  color: #7f93ad;
  padding: 16rpx 24rpx;
}

.profile-logout-btn--disabled {
  opacity: 0.6;
}

.profile-wechat-btn__icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.profile-menu {
  overflow: hidden;
  margin-bottom: 44rpx;
}

.profile-menu-row {
  height: 148rpx;
  display: flex;
  align-items: center;
  padding: 0 36rpx 0 46rpx;
  border-bottom: 2rpx solid rgba(119, 144, 176, 0.16);
}

.profile-menu-row:last-child {
  border-bottom: none;
}

.profile-menu-icon {
  width: 104rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.profile-menu-label {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 0.8rpx;
  color: #f5f7fb;
}

.profile-menu-chevron {
  flex-shrink: 0;
}

.profile-public-card {
  min-height: 192rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding: 36rpx 46rpx;
  margin-bottom: 24rpx;
}

.profile-public-heart {
  flex-shrink: 0;
}

.profile-public-title {
  font-size: 38rpx;
  margin-bottom: 8rpx;
  color: #f5f7fb;
}

.profile-public-sub {
  font-size: 26rpx;
  color: #a0adc1;
  line-height: 1.55;
}

.profile-login-sheet {
  position: fixed;
  inset: 0;
  z-index: 10000;
}

.profile-login-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(4, 10, 18, 0.72);
}

.profile-login-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #122238, #0e1d30);
  border-top: 2rpx solid rgba(121, 146, 180, 0.24);
  box-sizing: border-box;
}

.profile-login-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(162, 175, 196, 0.35);
}

.profile-login-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.profile-login-sheet__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: #8fa3c1;
}

.profile-login-sheet__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #f5f7fb;
}

.profile-login-sheet__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9cabc1;
  line-height: 1.5;
}

.profile-login-sheet__avatar {
  margin: 28rpx auto 0;
  padding: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.4;
}

.profile-login-sheet__avatar::after {
  border: none;
}

.profile-login-sheet__avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 4rpx solid rgba(114, 139, 173, 0.35);
}

.profile-login-sheet__avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8fa3c1;
}

.profile-login-sheet__input {
  margin-top: 28rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #eaf2ff;
  font-size: 28rpx;
}

.profile-login-sheet__confirm {
  margin: 32rpx 0 0;
  padding: 0;
  width: 100%;
  height: 92rpx;
  border: none;
  border-radius: 46rpx;
  background: linear-gradient(180deg, #27c8ce, #23b5c8);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.profile-login-sheet__confirm::after {
  border: none;
}

.profile-info-sheet {
  position: fixed;
  inset: 0;
  z-index: 10000;
}

.profile-info-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(4, 10, 18, 0.76);
}

.profile-info-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 76vh;
  padding: 16rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  border-top: 2rpx solid rgba(121, 146, 180, 0.26);
  background: linear-gradient(180deg, #122238, #0b192b);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -24rpx 70rpx rgba(0, 0, 0, 0.24);
}

.profile-info-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(162, 175, 196, 0.35);
  flex-shrink: 0;
}

.profile-info-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  flex-shrink: 0;
}

.profile-info-sheet__heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.profile-info-sheet__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: rgba(42, 194, 209, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-info-sheet__title {
  color: #f5f8fc;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
}

.profile-info-sheet__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8fa3c1;
  font-size: 44rpx;
  line-height: 1;
  flex-shrink: 0;
}

.profile-info-sheet__body {
  flex: 1;
  min-height: 0;
  margin-top: 26rpx;
}

.profile-info-sheet__intro {
  padding-bottom: 30rpx;
  color: #b7c3d4;
  font-size: 27rpx;
  line-height: 1.72;
}

.profile-info-sections {
  border-top: 2rpx solid rgba(119, 144, 176, 0.14);
}

.profile-info-section {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(119, 144, 176, 0.14);
}

.profile-info-section__number {
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid rgba(42, 194, 209, 0.42);
  border-radius: 50%;
  color: #31d3cf;
  font-size: 21rpx;
  line-height: 38rpx;
  text-align: center;
  flex-shrink: 0;
}

.profile-info-section__content {
  flex: 1;
  min-width: 0;
}

.profile-info-section__title {
  color: #edf3fa;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 650;
}

.profile-info-section__text {
  margin-top: 10rpx;
  color: #98a9bf;
  font-size: 25rpx;
  line-height: 1.72;
}

.profile-feedback-note {
  padding: 28rpx 0 30rpx;
  border-top: 2rpx solid rgba(119, 144, 176, 0.14);
  border-bottom: 2rpx solid rgba(119, 144, 176, 0.14);
}

.profile-feedback-note__title {
  margin-bottom: 22rpx;
  color: #edf3fa;
  font-size: 29rpx;
  line-height: 1.4;
  font-weight: 650;
}

.profile-feedback-note__item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 15rpx;
  color: #9fafc3;
  font-size: 25rpx;
  line-height: 1.62;
}

.profile-feedback-note__item text {
  color: #32d5cf;
  flex-shrink: 0;
}

.profile-feedback-button {
  width: 100%;
  height: 88rpx;
  margin: 34rpx 0 0;
  padding: 0;
  border-radius: 44rpx;
  border: 2rpx solid rgba(45, 221, 210, 0.7);
  background: linear-gradient(180deg, #27c8ce, #23b5c8);
  color: #ffffff;
  font-size: 29rpx;
  line-height: 88rpx;
  font-weight: 600;
}

.profile-feedback-button::after {
  border: none;
}

.profile-feedback-helper {
  padding: 18rpx 0 36rpx;
  color: #7489a4;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: center;
}
