.profile-card,
.login-card {
  margin-top: 24rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(53, 208, 186, 0.35);
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #EAF2FF;
  margin-bottom: 8rpx;
}

.profile-id {
  font-size: 24rpx;
  color: #8FA3C1;
}

.login-form {
  margin-top: 28rpx;
}

.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 32rpx 24rpx;
  margin: 0 0 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx dashed rgba(53, 208, 186, 0.35);
  line-height: 1.4;
}

.avatar-picker::after {
  border: none;
}

.avatar-picker__image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.avatar-picker__hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8FA3C1;
}

.nickname-field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 24rpx;
  color: #8FA3C1;
  margin-bottom: 12rpx;
}

.nickname-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #EAF2FF;
  font-size: 28rpx;
}

.btn-primary,
.btn-outline {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #35D0BA 0%, #2BB3A0 100%);
  color: #0B1020;
}

.btn-primary::after,
.btn-outline::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #35D0BA;
  border: 1rpx solid rgba(53, 208, 186, 0.45);
}
