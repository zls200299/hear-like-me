<view class="profile-page page-with-bg safe-bottom">
  <page-background variant="profile" tone="profile"></page-background>
  <view class="profile-grid" aria-hidden="true"></view>

  <view class="page-content profile-content">
    <view class="profile-card profile-login-card">
      <view class="profile-login-top">
        <view class="profile-login-avatar-col">
          <button
            wx:if="{{!loggedIn}}"
            class="profile-avatar-btn"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
          >
            <view class="profile-avatar">
              <image
                wx:if="{{avatarUrl}}"
                class="profile-avatar__image"
                src="{{avatarUrl}}"
                mode="aspectFill"
              />
              <image
                wx:else
                class="profile-avatar__placeholder"
                src="/assets/icons/profile-avatar-placeholder.svg"
                mode="aspectFit"
              />
            </view>
          </button>
          <view wx:else class="profile-avatar">
            <image
              class="profile-avatar__image"
              src="{{avatarUrl || defaultAvatar}}"
              mode="aspectFill"
            />
          </view>
        </view>

        <view class="profile-login-text">
          <view class="profile-login-title">{{loggedIn ? (nickname || '微信用户') : '未登录'}}</view>
          <view class="profile-login-sub">
            {{loggedIn ? ('ID ' + userId) : '登录后同步您的设置与数据'}}
          </view>
        </view>
      </view>

      <view class="profile-login-bottom">
        <button
          wx:if="{{!loggedIn}}"
          class="profile-wechat-btn"
          bindtap="onWechatLoginTap"
          loading="{{loggingIn}}"
          disabled="{{loggingIn}}"
        >
          <image class="profile-wechat-btn__icon" src="/assets/icons/profile-wechat.svg" mode="aspectFit" />
          <text>微信登录</text>
        </button>
        <view wx:else class="profile-login-tagline">
          像我一样聆听
          一款关于听觉、声码器和理解的教育工具
        </view>
      </view>
    </view>

    <view class="profile-card profile-menu">
      <view
        wx:for="{{menuItems}}"
        wx:key="key"
        class="profile-menu-row"
        data-key="{{item.key}}"
        bindtap="onMenuTap"
      >
        <view class="profile-menu-icon">
          <hlm-icon name="{{item.icon}}" size="66" color="#2ac2d1" />
        </view>
        <view class="profile-menu-label">{{item.label}}</view>
        <hlm-icon class="profile-menu-chevron" name="profile-chevron-right" size="42" color="#a2afc4" />
      </view>
    </view>

    <view class="profile-card profile-public-card">
      <hlm-icon class="profile-public-heart" name="profile-heart" size="74" color="#2ac2d1" />
      <view class="profile-public-text">
        <view class="profile-public-title">公益说明</view>
        <view class="profile-public-sub">本项目用于听觉科普与教育体验，不代表真实医疗效果。</view>
      </view>
    </view>

    <view wx:if="{{loggedIn}}" class="profile-logout-wrap">
      <view
        class="profile-logout-btn {{loggingOut ? 'profile-logout-btn--disabled' : ''}}"
        bindtap="onLogout"
      >
        {{loggingOut ? '退出中...' : '退出登录'}}
      </view>
    </view>
  </view>

  <view wx:if="{{loginSheetVisible}}" class="profile-login-sheet">
    <view class="profile-login-sheet__mask" bindtap="onCloseLoginSheet"></view>
    <view class="profile-login-sheet__panel">
      <view class="profile-login-sheet__handle" aria-hidden="true"></view>
      <view class="profile-login-sheet__header">
        <view class="profile-login-sheet__title">{{profileSheetMode === 'edit' ? '编辑账号信息' : '完善登录信息'}}</view>
        <view class="profile-login-sheet__close" bindtap="onCloseLoginSheet">×</view>
      </view>
      <view class="profile-login-sheet__desc">
        {{profileSheetMode === 'edit' ? '点击头像可重新选择，修改完成后记得保存' : '请选择头像并填写昵称后完成微信登录'}}
      </view>
      <button class="profile-login-sheet__avatar" open-type="chooseAvatar" bindchooseavatar="onSheetChooseAvatar">
        <image
          class="profile-login-sheet__avatar-img"
          src="{{sheetAvatarUrl || '/assets/icons/profile-avatar-placeholder.svg'}}"
          mode="aspectFill"
        />
        <text class="profile-login-sheet__avatar-hint">
          {{preparingAvatar ? '正在上传头像…' : (sheetAvatarUrl ? '更换头像' : '选择头像')}}
        </text>
      </button>
      <input
        id="loginNicknameInput"
        class="profile-login-sheet__input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{sheetNickname}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        bindnicknamereview="onNicknameReview"
        maxlength="32"
      />
      <button
        class="profile-login-sheet__confirm"
        bindtap="onProfileSubmit"
        loading="{{loggingIn || savingProfile}}"
        disabled="{{loggingIn || savingProfile || preparingAvatar}}"
      >
        {{profileSheetMode === 'edit' ? '保存修改' : '确认登录'}}
      </button>
    </view>
  </view>

  <view wx:if="{{infoSheetVisible && activePanel}}" class="profile-info-sheet">
    <view class="profile-info-sheet__mask" bindtap="onCloseInfoSheet"></view>
    <view class="profile-info-sheet__panel">
      <view class="profile-info-sheet__handle" aria-hidden="true"></view>
      <view class="profile-info-sheet__header">
        <view class="profile-info-sheet__heading">
          <view class="profile-info-sheet__icon">
            <hlm-icon name="{{activePanel.icon}}" size="48" color="#2ac2d1" />
          </view>
          <view class="profile-info-sheet__title">{{activePanel.title}}</view>
        </view>
        <view class="profile-info-sheet__close" bindtap="onCloseInfoSheet">×</view>
      </view>

      <scroll-view class="profile-info-sheet__body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="profile-info-sheet__intro">{{activePanel.intro}}</view>

        <block wx:if="{{activePanelKey === 'feedback'}}">
          <view class="profile-feedback-note">
            <view class="profile-feedback-note__title">为了更快定位问题</view>
            <view class="profile-feedback-note__item"><text>1</text><view>请写明问题出现在哪个页面</view></view>
            <view class="profile-feedback-note__item"><text>2</text><view>描述操作步骤和你期望看到的结果</view></view>
            <view class="profile-feedback-note__item"><text>3</text><view>如有异常画面，建议同时上传截图</view></view>
          </view>
          <button class="profile-feedback-button" open-type="feedback">进入微信意见反馈</button>
          <view class="profile-feedback-helper">反馈页由微信提供，可填写文字并附加图片。</view>
        </block>

        <view wx:else class="profile-info-sections">
          <view wx:for="{{activePanel.sections}}" wx:key="title" class="profile-info-section">
            <view class="profile-info-section__number">{{index + 1}}</view>
            <view class="profile-info-section__content">
              <view class="profile-info-section__title">{{item.title}}</view>
              <view class="profile-info-section__text">{{item.text}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
