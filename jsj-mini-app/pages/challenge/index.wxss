.challenge-page {
  min-height: 100vh;
  background-color: #020817;
}

.challenge-page.page-with-bg {
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.challenge-page .page-content {
  padding: 50rpx 42rpx 0;
}

.challenge-orbit {
  position: absolute;
  pointer-events: none;
  z-index: 1;
}

.challenge-orbit--left {
  left: -164rpx;
  top: 164rpx;
  width: 520rpx;
  height: 520rpx;
  border: 2rpx solid rgba(0, 172, 255, 0.18);
  border-radius: 50%;
  box-shadow:
    0 0 0 76rpx rgba(0, 135, 255, 0.028),
    0 0 0 152rpx rgba(0, 135, 255, 0.02);
}

.challenge-orbit--right {
  right: -540rpx;
  top: 150rpx;
  width: 1020rpx;
  height: 380rpx;
  border: 4rpx dashed rgba(22, 211, 231, 0.32);
  border-radius: 50%;
  transform: rotate(7deg);
}

.challenge-content {
  position: relative;
  z-index: 2;
}

.challenge-hero {
  padding: 0 20rpx 36rpx;
}

.challenge-hero__title {
  color: #27e0cf;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.6rpx;
  text-shadow: 0 0 40rpx rgba(39, 224, 207, 0.12);
}

.challenge-hero__heading {
  margin-top: 34rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #f3f6fb;
}

.challenge-hero__desc {
  margin-top: 20rpx;
  max-width: 650rpx;
  font-size: 30rpx;
  color: #a4b1c5;
  line-height: 1.55;
}

.challenge-card {
  background: linear-gradient(180deg, rgba(11, 27, 48, 0.96), rgba(8, 23, 40, 0.96));
  border: 3.2rpx solid rgba(81, 111, 147, 0.52);
  border-radius: 38rpx;
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.015),
    0 28rpx 68rpx rgba(0, 0, 0, 0.18);
}

.challenge-card--main {
  min-height: 560rpx;
  padding: 38rpx 38rpx 38rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 36rpx;
}

.challenge-disc {
  position: absolute;
  left: 50%;
  top: 72rpx;
  width: 480rpx;
  height: 480rpx;
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 1;
}

.challenge-disc__glow {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(27, 226, 212, 0.09) 0 26%, transparent 27% 100%);
  box-shadow: 0 0 100rpx rgba(30, 221, 215, 0.06);
}

.challenge-disc__ring {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  box-sizing: border-box;
  background: transparent;
}

.challenge-disc__ring--1 {
  width: 237rpx;
  height: 237rpx;
  border: 2rpx solid rgba(46, 235, 227, 0.42);
}

.challenge-disc__ring--2 {
  width: 309rpx;
  height: 309rpx;
  border: 2rpx solid rgba(36, 207, 235, 0.34);
}

.challenge-disc__ring--3 {
  width: 391rpx;
  height: 391rpx;
  border: 2rpx dashed rgba(25, 138, 194, 0.38);
}

.challenge-disc__ring--4 {
  width: 480rpx;
  height: 480rpx;
  border: 2rpx dashed rgba(18, 110, 157, 0.32);
}

.challenge-badge {
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 34rpx;
  border: 2rpx solid rgba(39, 224, 207, 0.27);
  border-radius: 50rpx;
  background: rgba(31, 113, 124, 0.17);
  color: #27e0cf;
  font-size: 32rpx;
  font-weight: 700;
  position: relative;
  z-index: 2;
}

.challenge-unknown {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: -4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.challenge-unknown__mark {
  margin-top: -16rpx;
  color: #27e0cf;
  font-size: 200rpx;
  line-height: 0.92;
  font-weight: 700;
  text-shadow:
    0 0 36rpx rgba(39, 224, 207, 0.5),
    0 0 90rpx rgba(39, 224, 207, 0.18);
}

.challenge-unknown__label {
  margin-top: 6rpx;
  font-size: 36rpx;
  letter-spacing: 0.6rpx;
  color: #f3f6fb;
}

.challenge-play-btn {
  margin-top: 44rpx;
  width: 70%;
  max-width: 720rpx;
  height: 112rpx;
  padding: 0;
  border: 0;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #08202b;
  background: linear-gradient(90deg, #34dfd4, #28d6c7);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow:
    inset 0 0 0 2rpx rgba(90, 255, 242, 0.65),
    0 0 52rpx rgba(39, 224, 207, 0.25);
}

.challenge-play-btn::after {
  border: none;
}

.challenge-play-btn__icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(7, 28, 42, 0.92);
}

.challenge-play-btn__icon-img {
  width: 36rpx;
  height: 38rpx;
}

.challenge-listen-tip {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #94a4bc;
  font-size: 26rpx;
}

.challenge-card--answer {
  min-height: 390rpx;
  padding: 38rpx 38rpx 38rpx;
  margin-bottom: 36rpx;
}

.challenge-section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #f3f6fb;
}

.challenge-answers {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 30rpx;
  row-gap: 22rpx;
}

.challenge-answer {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  height: 116rpx;
  border: 3.2rpx solid rgba(86, 112, 146, 0.67);
  border-radius: 30rpx;
  background: rgba(9, 23, 41, 0.72);
  color: #eef3fa;
  font-size: 38rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.challenge-answer--selected {
  border-color: #27e0cf;
  background: linear-gradient(90deg, rgba(14, 94, 103, 0.5), rgba(18, 74, 82, 0.35));
  box-shadow:
    inset 0 0 0 2rpx rgba(48, 239, 219, 0.2),
    0 0 36rpx rgba(39, 224, 207, 0.08);
}

.challenge-answer__check {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: none;
  align-items: center;
  justify-content: center;
  background: #27e0cf;
}

.challenge-answer--selected .challenge-answer__check {
  display: flex;
}

.challenge-submit-btn {
  margin-top: 36rpx;
  width: 100%;
  height: 104rpx;
  border: none;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #08202b;
  font-size: 36rpx;
  font-weight: 800;
  background: linear-gradient(90deg, #34dfd4, #28d6c7);
  box-shadow:
    inset 0 0 0 2rpx rgba(90, 255, 242, 0.65),
    0 0 40rpx rgba(39, 224, 207, 0.2);
}

.challenge-submit-btn::after {
  border: none;
}

.challenge-submit-btn--disabled,
.challenge-submit-btn[disabled] {
  opacity: 0.55;
}

.challenge-card--score {
  height: 148rpx;
  display: flex;
  align-items: center;
  padding: 0 48rpx;
  margin-bottom: 36rpx;
}

.challenge-score-vline {
  width: 2rpx;
  height: 96rpx;
  background: rgba(102, 128, 159, 0.25);
  flex-shrink: 0;
}

.challenge-score-block {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

.challenge-score-block--right {
  padding-left: 48rpx;
}

.challenge-score-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(20, 97, 108, 0.21);
  flex-shrink: 0;
}

.challenge-score-small {
  font-size: 26rpx;
  color: #a2aec1;
}

.challenge-score-value {
  margin-top: 10rpx;
  font-size: 36rpx;
  color: #f3f6fb;
}

.challenge-score-num {
  color: #27e0cf;
  font-weight: 500;
  font-size: 40rpx;
}

.challenge-card--info {
  min-height: 182rpx;
  padding: 30rpx 38rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-bottom: 32rpx;
}

.challenge-info-icon {
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: rgba(26, 51, 80, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.challenge-info-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #f3f6fb;
}

.challenge-info-text {
  font-size: 26rpx;
  line-height: 1.55;
  color: #a4b1c6;
}
