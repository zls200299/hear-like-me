/* app.wxss */
page {
  min-height: 100%;
  background: #0B1020;
  color: #EAF2FF;
  font-size: 28rpx;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #0B1020;
}

.page-with-bg {
  position: relative;
  min-height: 100vh;
  background-color: #07111f;
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
}

.page-with-bg .page-content {
  position: relative;
  z-index: 2;
  padding: 24rpx;
  padding-bottom: 0;
}

.page.safe-bottom {
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.page-title {
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #EAF2FF;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 500;
  color: #35D0BA;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #EAF2FF;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #8FA3C1;
}

.placeholder {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(53, 208, 186, 0.08);
  border: 1rpx dashed rgba(53, 208, 186, 0.35);
  color: #8FA3C1;
  font-size: 26rpx;
  line-height: 1.6;
}
