<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.ContentCategoryDao">
	<resultMap id="result_ContentCategoryMapper.xml" type="com.zhs.model.ContentCategory">
		<id column="id" property="id" />
		<result column="category_code" property="categoryCode" />
		<result column="name_cn" property="nameCn" />
		<result column="name_en" property="nameEn" />
		<result column="description_cn" property="descriptionCn" />
		<result column="description_en" property="descriptionEn" />
		<result column="sort_order" property="sortOrder" />
		<result column="enabled" property="enabled" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<!-- 数据库中表名为:content_category的列名 -->
	<sql id="content_category_Column">
		id,category_code,name_cn,name_en,description_cn,description_en,sort_order,enabled,create_time,update_time,is_delete
	</sql>

	<!-- 通过ContentCategory的id获得对应数据库中表的数据对象 -->
	<select id="selectContentCategoryById" parameterType="Long" resultMap="result_ContentCategoryMapper.xml">
		select
		<include refid="content_category_Column" />
		from content_category
		where id = #{id}
	</select>
	
	<!-- 获得一个ContentCategory对象,以参数ContentCategory对象中不为空的属性作为条件进行查询 -->
	<select id="selectContentCategoryObjSingle" parameterType="com.zhs.model.ContentCategory" resultMap="result_ContentCategoryMapper.xml">
		select
		<include refid="content_category_Column" />
		from content_category
		<where>
		<if test="nameEn != null"> and name_en = #{nameEn}</if>
		<if test="descriptionCn != null"> and description_cn = #{descriptionCn}</if>
		<if test="descriptionEn != null"> and description_en = #{descriptionEn}</if>
		<if test="sortOrder != null"> and sort_order = #{sortOrder}</if>
		<if test="enabled != null"> and enabled = #{enabled}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="categoryCode != null"> and category_code = #{categoryCode}</if>
		<if test="nameCn != null"> and name_cn = #{nameCn}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得ContentCategory对象,以参数ContentCategory对象中不为空的属性作为条件进行查询 -->
	<select id="selectContentCategoryByObj" parameterType="com.zhs.model.ContentCategory" resultMap="result_ContentCategoryMapper.xml">
		select
		<include refid="content_category_Column" />
		from content_category
		<where>
		<if test="nameEn != null"> and name_en = #{nameEn}</if>
		<if test="descriptionCn != null"> and description_cn = #{descriptionCn}</if>
		<if test="descriptionEn != null"> and description_en = #{descriptionEn}</if>
		<if test="sortOrder != null"> and sort_order = #{sortOrder}</if>
		<if test="enabled != null"> and enabled = #{enabled}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="categoryCode != null"> and category_code = #{categoryCode}</if>
		<if test="nameCn != null"> and name_cn = #{nameCn}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将ContentCategory插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertContentCategory" parameterType="com.zhs.model.ContentCategory">
		insert into 
		content_category (id,category_code,name_cn,name_en,description_cn,description_en,sort_order,enabled,create_time,update_time,is_delete) 
		values(#{id},#{categoryCode},#{nameCn},#{nameEn},#{descriptionCn},#{descriptionEn},#{sortOrder},#{enabled},#{createTime},#{updateTime},#{isDelete})
	</insert>

	<!-- 将ContentCategory中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullContentCategory" parameterType="com.zhs.model.ContentCategory">
		insert into content_category
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="categoryCode != null">category_code,</if>
			<if test="nameCn != null">name_cn,</if>
			<if test="nameEn != null">name_en,</if>
			<if test="descriptionCn != null">description_cn,</if>
			<if test="descriptionEn != null">description_en,</if>
			<if test="sortOrder != null">sort_order,</if>
			<if test="enabled != null">enabled,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="categoryCode != null">#{categoryCode},</if>
			<if test="nameCn != null">#{nameCn},</if>
			<if test="nameEn != null">#{nameEn},</if>
			<if test="descriptionCn != null">#{descriptionCn},</if>
			<if test="descriptionEn != null">#{descriptionEn},</if>
			<if test="sortOrder != null">#{sortOrder},</if>
			<if test="enabled != null">#{enabled},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateTime != null">#{updateTime},</if>
			<if test="isDelete != null">#{isDelete},</if>
		</trim>
	</insert>

	<!-- 将ContentCategory批量插入到对应数据库的表中 -->
	<insert id="insertContentCategoryByBatch" parameterType="ArrayList">
		insert into content_category(id,category_code,name_cn,name_en,description_cn,description_en,sort_order,enabled,create_time,update_time,is_delete) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{categoryCode},#{nameCn},#{nameEn},#{descriptionCn},#{descriptionEn},#{sortOrder},#{enabled},#{createTime},#{updateTime},#{isDelete})
		</foreach>
	</insert>
	
	<!-- 通过ContentCategory的id将数据库表中对应的数据删除 -->
	<delete id="deleteContentCategoryById" parameterType="Long">
		delete from content_category
		where  id  =  #{id}
	</delete>



	<!-- 通过ContentCategory的id将ContentCategory的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateContentCategoryById" parameterType="com.zhs.model.ContentCategory"> 
		update content_category set
		<set>
			category_code = #{categoryCode} , 
			name_cn = #{nameCn} , 
			name_en = #{nameEn} , 
			description_cn = #{descriptionCn} , 
			description_en = #{descriptionEn} , 
			sort_order = #{sortOrder} , 
			enabled = #{enabled} , 
			create_time = #{createTime} , 
			update_time = #{updateTime} , 
			is_delete = #{isDelete} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过ContentCategory的id将ContentCategory中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullContentCategoryById" parameterType="com.zhs.model.ContentCategory">
		update content_category
		<set>
					<if test="categoryCode != null">category_code = #{categoryCode},</if>
					<if test="nameCn != null">name_cn = #{nameCn},</if>
					<if test="nameEn != null">name_en = #{nameEn},</if>
					<if test="descriptionCn != null">description_cn = #{descriptionCn},</if>
					<if test="descriptionEn != null">description_en = #{descriptionEn},</if>
					<if test="sortOrder != null">sort_order = #{sortOrder},</if>
					<if test="enabled != null">enabled = #{enabled},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
					<if test="isDelete != null">is_delete = #{isDelete},</if>
		</set>
		where id = #{id}
	</update>

</mapper>