<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.UserLoginSessionDao">
	<resultMap id="result_UserLoginSessionMapper.xml" type="com.zhs.model.UserLoginSession">
		<id column="id" property="id" />
		<result column="user_id" property="userId" />
		<result column="token" property="token" />
		<result column="expire_time" property="expireTime" />
		<result column="login_time" property="loginTime" />
		<result column="device_type" property="deviceType" />
		<result column="client_ip" property="clientIp" />
		<result column="status" property="status" />
		<result column="is_delete" property="isDelete" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
	</resultMap>
	<!-- 数据库中表名为:user_login_session的列名 -->
	<sql id="user_login_session_Column">
		id,user_id,token,login_time,expire_time,device_type,client_ip,status,is_delete,create_time,update_time
	</sql>

	<!-- 通过UserLoginSession的id获得对应数据库中表的数据对象 -->
	<select id="selectUserLoginSessionById" parameterType="Long" resultMap="result_UserLoginSessionMapper.xml">
		select
		<include refid="user_login_session_Column" />
		from user_login_session
		where id = #{id}
	</select>
	
	<!-- 获得一个UserLoginSession对象,以参数UserLoginSession对象中不为空的属性作为条件进行查询 -->
	<select id="selectUserLoginSessionObjSingle" parameterType="com.zhs.model.UserLoginSession" resultMap="result_UserLoginSessionMapper.xml">
		select
		<include refid="user_login_session_Column" />
		from user_login_session
		<where>
		<if test="loginTime != null"> and login_time = #{loginTime}</if>
		<if test="deviceType != null"> and device_type = #{deviceType}</if>
		<if test="clientIp != null"> and client_ip = #{clientIp}</if>
		<if test="status != null"> and status = #{status}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="userId != null"> and user_id = #{userId}</if>
		<if test="token != null"> and token = #{token}</if>
		<if test="expireTime != null"> and expire_time = #{expireTime}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得UserLoginSession对象,以参数UserLoginSession对象中不为空的属性作为条件进行查询 -->
	<select id="selectUserLoginSessionByObj" parameterType="com.zhs.model.UserLoginSession" resultMap="result_UserLoginSessionMapper.xml">
		select
		<include refid="user_login_session_Column" />
		from user_login_session
		<where>
		<if test="loginTime != null"> and login_time = #{loginTime}</if>
		<if test="deviceType != null"> and device_type = #{deviceType}</if>
		<if test="clientIp != null"> and client_ip = #{clientIp}</if>
		<if test="status != null"> and status = #{status}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="userId != null"> and user_id = #{userId}</if>
		<if test="token != null"> and token = #{token}</if>
		<if test="expireTime != null"> and expire_time = #{expireTime}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将UserLoginSession插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertUserLoginSession" parameterType="com.zhs.model.UserLoginSession">
		insert into 
		user_login_session (id,user_id,token,login_time,expire_time,device_type,client_ip,status,is_delete,create_time,update_time) 
		values(#{id},#{userId},#{token},#{loginTime},#{expireTime},#{deviceType},#{clientIp},#{status},#{isDelete},#{createTime},#{updateTime})
	</insert>

	<!-- 将UserLoginSession中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullUserLoginSession" parameterType="com.zhs.model.UserLoginSession">
		insert into user_login_session
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="userId != null">user_id,</if>
			<if test="token != null">token,</if>
			<if test="loginTime != null">login_time,</if>
			<if test="expireTime != null">expire_time,</if>
			<if test="deviceType != null">device_type,</if>
			<if test="clientIp != null">client_ip,</if>
			<if test="status != null">status,</if>
			<if test="isDelete != null">is_delete,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="userId != null">#{userId},</if>
			<if test="token != null">#{token},</if>
			<if test="loginTime != null">#{loginTime},</if>
			<if test="expireTime != null">#{expireTime},</if>
			<if test="deviceType != null">#{deviceType},</if>
			<if test="clientIp != null">#{clientIp},</if>
			<if test="status != null">#{status},</if>
			<if test="isDelete != null">#{isDelete},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateTime != null">#{updateTime},</if>
		</trim>
	</insert>

	<!-- 将UserLoginSession批量插入到对应数据库的表中 -->
	<insert id="insertUserLoginSessionByBatch" parameterType="ArrayList">
		insert into user_login_session(id,user_id,token,login_time,expire_time,device_type,client_ip,status,is_delete,create_time,update_time) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{userId},#{token},#{loginTime},#{expireTime},#{deviceType},#{clientIp},#{status},#{isDelete},#{createTime},#{updateTime})
		</foreach>
	</insert>
	
