		where  id  =  #{id}
	</delete>



	<!-- 通过UserLoginSession的id将UserLoginSession的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateUserLoginSessionById" parameterType="com.zhs.model.UserLoginSession"> 
		update user_login_session set
		<set>
			user_id = #{userId} , 
			token = #{token} , 
			login_time = #{loginTime} , 
			expire_time = #{expireTime} , 
			device_type = #{deviceType} , 
			client_ip = #{clientIp} , 
			status = #{status} , 
			is_delete = #{isDelete} , 
			create_time = #{createTime} , 
			update_time = #{updateTime} , 
		</set>
