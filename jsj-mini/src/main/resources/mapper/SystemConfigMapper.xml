<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.SystemConfigDao">
	<resultMap id="result_SystemConfigMapper.xml" type="com.zhs.model.SystemConfig">
		<id column="id" property="id" />
		<result column="config_key" property="configKey" />
		<result column="config_value" property="configValue" />
		<result column="value_type" property="valueType" />
		<result column="description" property="description" />
		<result column="enabled" property="enabled" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
	</resultMap>
	<!-- 数据库中表名为:system_config的列名 -->
	<sql id="system_config_Column">
		id,config_key,config_value,value_type,description,enabled,create_time,update_time
	</sql>

	<!-- 通过SystemConfig的id获得对应数据库中表的数据对象 -->
	<select id="selectSystemConfigById" parameterType="Long" resultMap="result_SystemConfigMapper.xml">
		select
		<include refid="system_config_Column" />
		from system_config
		where id = #{id}
	</select>
	
	<!-- 获得一个SystemConfig对象,以参数SystemConfig对象中不为空的属性作为条件进行查询 -->
	<select id="selectSystemConfigObjSingle" parameterType="com.zhs.model.SystemConfig" resultMap="result_SystemConfigMapper.xml">
		select
		<include refid="system_config_Column" />
		from system_config
		<where>
		<if test="valueType != null"> and value_type = #{valueType}</if>
		<if test="description != null"> and description = #{description}</if>
		<if test="enabled != null"> and enabled = #{enabled}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="configKey != null"> and config_key = #{configKey}</if>
		<if test="configValue != null"> and config_value = #{configValue}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得SystemConfig对象,以参数SystemConfig对象中不为空的属性作为条件进行查询 -->
	<select id="selectSystemConfigByObj" parameterType="com.zhs.model.SystemConfig" resultMap="result_SystemConfigMapper.xml">
		select
		<include refid="system_config_Column" />
		from system_config
		<where>
		<if test="valueType != null"> and value_type = #{valueType}</if>
		<if test="description != null"> and description = #{description}</if>
		<if test="enabled != null"> and enabled = #{enabled}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="configKey != null"> and config_key = #{configKey}</if>
		<if test="configValue != null"> and config_value = #{configValue}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将SystemConfig插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertSystemConfig" parameterType="com.zhs.model.SystemConfig">
		insert into 
		system_config (id,config_key,config_value,value_type,description,enabled,create_time,update_time) 
		values(#{id},#{configKey},#{configValue},#{valueType},#{description},#{enabled},#{createTime},#{updateTime})
	</insert>

	<!-- 将SystemConfig中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullSystemConfig" parameterType="com.zhs.model.SystemConfig">
		insert into system_config
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="configKey != null">config_key,</if>
			<if test="configValue != null">config_value,</if>
			<if test="valueType != null">value_type,</if>
			<if test="description != null">description,</if>
			<if test="enabled != null">enabled,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="configKey != null">#{configKey},</if>
			<if test="configValue != null">#{configValue},</if>
			<if test="valueType != null">#{valueType},</if>
			<if test="description != null">#{description},</if>
			<if test="enabled != null">#{enabled},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateTime != null">#{updateTime},</if>
		</trim>
	</insert>

	<!-- 将SystemConfig批量插入到对应数据库的表中 -->
	<insert id="insertSystemConfigByBatch" parameterType="ArrayList">
		insert into system_config(id,config_key,config_value,value_type,description,enabled,create_time,update_time) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{configKey},#{configValue},#{valueType},#{description},#{enabled},#{createTime},#{updateTime})
		</foreach>
	</insert>
	
	<!-- 通过SystemConfig的id将数据库表中对应的数据删除 -->
	<delete id="deleteSystemConfigById" parameterType="Long">
		delete from system_config
		where  id  =  #{id}
	</delete>



	<!-- 通过SystemConfig的id将SystemConfig的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateSystemConfigById" parameterType="com.zhs.model.SystemConfig"> 
		update system_config set
		<set>
			config_key = #{configKey} , 
			config_value = #{configValue} , 
			value_type = #{valueType} , 
			description = #{description} , 
			enabled = #{enabled} , 
			create_time = #{createTime} , 
			update_time = #{updateTime} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过SystemConfig的id将SystemConfig中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullSystemConfigById" parameterType="com.zhs.model.SystemConfig">
		update system_config
		<set>
					<if test="configKey != null">config_key = #{configKey},</if>
					<if test="configValue != null">config_value = #{configValue},</if>
					<if test="valueType != null">value_type = #{valueType},</if>
					<if test="description != null">description = #{description},</if>
					<if test="enabled != null">enabled = #{enabled},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
		</set>
		where id = #{id}
	</update>

</mapper>