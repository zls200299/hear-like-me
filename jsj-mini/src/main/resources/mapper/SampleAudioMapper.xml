<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.SampleAudioDao">
	<resultMap id="result_SampleAudioMapper" type="com.zhs.model.SampleAudio">
		<id column="id" property="id" />
		<result column="sample_code" property="sampleCode" />
		<result column="name_cn" property="nameCn" />
		<result column="name_en" property="nameEn" />
		<result column="description_cn" property="descriptionCn" />
		<result column="description_en" property="descriptionEn" />
		<result column="asset_id" property="assetId" />
		<result column="generator_type" property="generatorType" />
		<result column="sort_order" property="sortOrder" />
		<result column="enabled" property="enabled" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<!-- 数据库中表名为:sample_audio的列名 -->
	<sql id="sample_audio_Column">
		id,sample_code,name_cn,name_en,description_cn,description_en,asset_id,generator_type,sort_order,enabled,create_time,update_time,is_delete
	</sql>

	<!-- 通过SampleAudio的id获得对应数据库中表的数据对象 -->
	<select id="selectSampleAudioById" parameterType="Long" resultMap="result_SampleAudioMapper">
		select
		<include refid="sample_audio_Column" />
		from sample_audio
		where id = #{id}
	</select>
	
	<!-- 获得一个SampleAudio对象,以参数SampleAudio对象中不为空的属性作为条件进行查询 -->
	<select id="selectSampleAudioObjSingle" parameterType="com.zhs.model.SampleAudio" resultMap="result_SampleAudioMapper">
		select
		<include refid="sample_audio_Column" />
		from sample_audio
		<where>
		<if test="nameEn != null"> and name_en = #{nameEn}</if>
		<if test="descriptionCn != null"> and description_cn = #{descriptionCn}</if>
		<if test="descriptionEn != null"> and description_en = #{descriptionEn}</if>
		<if test="assetId != null"> and asset_id = #{assetId}</if>
		<if test="generatorType != null"> and generator_type = #{generatorType}</if>
		<if test="sortOrder != null"> and sort_order = #{sortOrder}</if>
		<if test="enabled != null"> and enabled = #{enabled}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="sampleCode != null"> and sample_code = #{sampleCode}</if>
		<if test="nameCn != null"> and name_cn = #{nameCn}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得SampleAudio对象,以参数SampleAudio对象中不为空的属性作为条件进行查询 -->
	<select id="selectSampleAudioByObj" parameterType="com.zhs.model.SampleAudio" resultMap="result_SampleAudioMapper">
		select
		<include refid="sample_audio_Column" />
		from sample_audio
		<where>
		<if test="nameEn != null"> and name_en = #{nameEn}</if>
		<if test="descriptionCn != null"> and description_cn = #{descriptionCn}</if>
		<if test="descriptionEn != null"> and description_en = #{descriptionEn}</if>
		<if test="assetId != null"> and asset_id = #{assetId}</if>
		<if test="generatorType != null"> and generator_type = #{generatorType}</if>
		<if test="sortOrder != null"> and sort_order = #{sortOrder}</if>
		<if test="enabled != null"> and enabled = #{enabled}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="sampleCode != null"> and sample_code = #{sampleCode}</if>
		<if test="nameCn != null"> and name_cn = #{nameCn}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将SampleAudio插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertSampleAudio" parameterType="com.zhs.model.SampleAudio">
		insert into 
		sample_audio (id,sample_code,name_cn,name_en,description_cn,description_en,asset_id,generator_type,sort_order,enabled,create_time,update_time,is_delete) 
		values(#{id},#{sampleCode},#{nameCn},#{nameEn},#{descriptionCn},#{descriptionEn},#{assetId},#{generatorType},#{sortOrder},#{enabled},#{createTime},#{updateTime},#{isDelete})
	</insert>

	<!-- 将SampleAudio中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullSampleAudio" parameterType="com.zhs.model.SampleAudio">
		insert into sample_audio
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="sampleCode != null">sample_code,</if>
			<if test="nameCn != null">name_cn,</if>
			<if test="nameEn != null">name_en,</if>
			<if test="descriptionCn != null">description_cn,</if>
			<if test="descriptionEn != null">description_en,</if>
			<if test="assetId != null">asset_id,</if>
			<if test="generatorType != null">generator_type,</if>
			<if test="sortOrder != null">sort_order,</if>
			<if test="enabled != null">enabled,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="sampleCode != null">#{sampleCode},</if>
			<if test="nameCn != null">#{nameCn},</if>
			<if test="nameEn != null">#{nameEn},</if>
			<if test="descriptionCn != null">#{descriptionCn},</if>
			<if test="descriptionEn != null">#{descriptionEn},</if>
			<if test="assetId != null">#{assetId},</if>
			<if test="generatorType != null">#{generatorType},</if>
			<if test="sortOrder != null">#{sortOrder},</if>
			<if test="enabled != null">#{enabled},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateTime != null">#{updateTime},</if>
			<if test="isDelete != null">#{isDelete},</if>
		</trim>
	</insert>

	<!-- 将SampleAudio批量插入到对应数据库的表中 -->
	<insert id="insertSampleAudioByBatch" parameterType="ArrayList">
		insert into sample_audio(id,sample_code,name_cn,name_en,description_cn,description_en,asset_id,generator_type,sort_order,enabled,create_time,update_time,is_delete) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{sampleCode},#{nameCn},#{nameEn},#{descriptionCn},#{descriptionEn},#{assetId},#{generatorType},#{sortOrder},#{enabled},#{createTime},#{updateTime},#{isDelete})
		</foreach>
	</insert>
	
	<!-- 通过SampleAudio的id将数据库表中对应的数据删除 -->
	<delete id="deleteSampleAudioById" parameterType="Long">
		delete from sample_audio
		where  id  =  #{id}
	</delete>



	<!-- 通过SampleAudio的id将SampleAudio的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateSampleAudioById" parameterType="com.zhs.model.SampleAudio"> 
		update sample_audio set
		<set>
			sample_code = #{sampleCode} , 
			name_cn = #{nameCn} , 
			name_en = #{nameEn} , 
			description_cn = #{descriptionCn} , 
			description_en = #{descriptionEn} , 
			asset_id = #{assetId} , 
